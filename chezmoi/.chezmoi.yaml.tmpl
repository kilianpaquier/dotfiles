{{- $dev := false -}}
{{- if ne .chezmoi.os "windows" -}}
  {{- $dev = promptBoolOnce . "dev" "Is this a development machine (full tooling, git, etc.)" -}}
{{- end -}}

{{- $profiles := list "home" "soprasteria" -}}
{{- $profile := promptChoiceOnce . "profile" "Which profile should apply to this machine" $profiles -}}

{{- $gaming := false -}}
{{- if and (eq $profile "home") (eq .chezmoi.os "windows") -}}
  {{- $gaming = promptBoolOnce . "gaming" "Is this a gaming machine" -}}
{{- end -}}

{{- $shell := "powershell" -}}
{{- if ne .chezmoi.os "windows" -}}
  {{- $shell = promptChoiceOnce . "shell" "Which shell will you be using" (list "bash" "zsh") "bash" -}}
{{- end -}}

{{- $ide := promptMultichoiceOnce . "ide" "What IDE are you using to develop" (list "intellij" "vscode" "zed") (list "vscode") -}}

{{- $ssh_generate := promptBoolOnce . "ssh.generate" "Would you like to generate an SSH key" -}}
{{- $machine_name := "" -}}
{{- if $ssh_generate -}}
  {{- $machine_name = promptStringOnce . "machine_name" "What is this machine's name" .chezmoi.hostname -}}
{{- end -}}

{{- $email := "" -}}
{{- $username := "" -}}
{{- if or $dev $ssh_generate -}}
  {{- $username = promptStringOnce . "user.username" "What is your comitter username" -}}
  {{- $email = promptStringOnce . "user.email" "What is your committer email" -}}
{{- end -}}

{{- $agents := list -}}
{{- $agents_available := list "claude" "copilot" -}}

{{- $plugins := list -}}
{{- $plugins_available := list "caveman" "ponytail" -}}
{{- $plugins_default := list "caveman" "ponytail" -}}

{{- $tools_management := list -}}
{{- $tools_management_available := list "brew" "mise" "node" "uv" -}}
{{- $tools_management_default := list "mise" "node" "uv" -}}

{{- $profile_extra_tools := list -}}
{{- if eq $profile "home" -}}
  {{- $profile_extra_tools = list "bun" "incus" "opentofu" -}}
{{- else if eq $profile "soprasteria" -}}
  {{- $profile_extra_tools = list "java" "k6" "k8s" "terraform" -}}
{{- end -}}

{{- $tools_common_default := list "git-tools" "go" "hugo" "rtk" "shell" "uv" -}}

{{- $tools_brew_available := list "bun" "git-tools" "go" "hugo" "incus" "java" "just" "k6" "k8s" "kotlin" "opentofu" "rtk" "shell" "task" "terraform" "typescript" "uv" -}}
{{- $tools_brew_default := list -}}

{{- $tools_mise_available := list "bun" "codebase-memory-mcp" "codegraph" "git-tools" "go" "graphify" "hugo" "incus" "java" "just" "k6" "k8s" "kotlin" "mempalace" "opentofu" "rtk" "shell" "task" "terraform" "typescript" "uv" -}}
{{- $tools_mise_default := list -}}

{{- $tools_node_available := list "bun" "cavemem" "hugo" "pnpm" "shell" "task" "typescript" "yarn" -}}
{{- $tools_node_default := list -}}

{{- $tools_uv_available := list "graphify" "just" "mempalace" -}}
{{- $tools_uv_default := list -}}

{{- $tools := dict "brew" (list) "mise" (list) "node" (list) "uv" (list) -}}
{{- $git_ssh := false -}}
{{- if $dev -}}
  {{- $git_ssh = promptBoolOnce . "git.ssh" "Would you like to sign commits with your SSH key" -}}
  {{- $agents = promptMultichoiceOnce . "ai.agents" "Which AI agent(s) will you be using" $agents_available -}}

  {{- if gt (len $agents) 0 -}}
    {{- $plugins = promptMultichoiceOnce . "ai.plugins" "Which agent plugin(s) would you like to install" $plugins_available $plugins_default -}}
  {{- end -}}

  {{- $_ := warnf "available tools per manager:\n  brew: %s\n  mise: %s\n  node: %s\n  uv: %s"
      ($tools_brew_available | join ", ")
      ($tools_mise_available | join ", ")
      ($tools_node_available | join ", ")
      ($tools_uv_available | join ", ") -}}

  {{- $tools_management = promptMultichoiceOnce . "tools_management" "Which tool manager(s) would you like to use" $tools_management_available $tools_management_default -}}

  {{- if has "mise" $tools_management -}}
    {{- $tools_mise_default = concat $tools_common_default $profile_extra_tools -}}
  {{- else if has "brew" $tools_management -}}
    {{- $tools_brew_default = concat $tools_common_default $profile_extra_tools -}}
  {{- end -}}

  {{- if has "mise" $tools_management -}}
    {{- $_ := set $tools "mise" (promptMultichoiceOnce . "tools.mise" "Which tools would you like to install via mise" $tools_mise_available $tools_mise_default) -}}

    {{- $brew_left := list -}}
    {{- range $tools_brew_available -}}
      {{- if not (has . $tools.mise) -}}
        {{- $brew_left = append $brew_left . -}}
      {{- end -}}
    {{- end -}}
    {{- $tools_brew_available = $brew_left -}}

    {{- $node_left := list -}}
    {{- range $tools_node_available -}}
      {{- if not (has . $tools.mise) -}}
        {{- $node_left = append $node_left . -}}
      {{- end -}}
    {{- end -}}
    {{- $tools_node_available = $node_left -}}

    {{- $uv_left := list -}}
    {{- range $tools_uv_available -}}
      {{- if not (has . $tools.mise) -}}
        {{- $uv_left = append $uv_left . -}}
      {{- end -}}
    {{- end -}}
    {{- $tools_uv_available = $uv_left -}}
  {{- end -}}

  {{- if has "brew" $tools_management -}}
    {{- $_ := set $tools "brew" (promptMultichoiceOnce . "tools.brew" "Which tools would you like to install via brew" $tools_brew_available $tools_brew_default) -}}

    {{- $node_left := list -}}
    {{- range $tools_node_available -}}
      {{- if not (has . $tools.brew) -}}
        {{- $node_left = append $node_left . -}}
      {{- end -}}
    {{- end -}}
    {{- $tools_node_available = $node_left -}}
  {{- end -}}

  {{- if has "node" $tools_management -}}
    {{- $_ := set $tools "node" (promptMultichoiceOnce . "tools.node" "Which tools would you like to install via node" $tools_node_available $tools_node_default) -}}
  {{- end -}}

  {{- if has "uv" $tools_management -}}
    {{- $_ := set $tools "uv" (promptMultichoiceOnce . "tools.uv" "Which tools would you like to install via uv" $tools_uv_available $tools_uv_default) -}}
  {{- end -}}
{{- end -}}

# available agent runtimes: {{ $agents_available | join ", " }}
# available agent plugins: {{ $plugins_available | join ", " }}
# available tools_management: {{ $tools_management_available | join ", " }}
# available tools.brew: {{ $tools_brew_available | join ", " }}
# available tools.mise: {{ $tools_mise_available | join ", " }}
# available tools.node: {{ $tools_node_available | join ", " }}
# available tools.uv: {{ $tools_uv_available | join ", " }}

umask: 0o22

data:
  ai:
    agents:{{ if eq (len $agents) 0 }} []{{ end }}
{{- range $agents }}
      - {{ . }}
{{- end }}
    plugins:{{ if eq (len $plugins) 0 }} []{{ end }}
{{- range $plugins }}
      - {{ . }}
{{- end }}
  machine_name: {{ $machine_name }}
  dev: {{ $dev }}
  gaming: {{ $gaming }}
  git:
    ssh: {{ $git_ssh }}
  ssh:
    generate: {{ $ssh_generate }}
  user:
    email: {{ $email }}
    username: {{ $username }}
  ide:{{ if eq (len $ide) 0 }} []{{ end }}
{{- range $ide }}
    - {{ . }}
{{- end }}
  profile: {{ $profile }}
  shell: {{ $shell }}
  tools_management:{{ if eq (len $tools_management) 0 }} []{{ end }}
{{- range $tools_management }}
    - {{ . }}
{{- end }}
  tools:
    brew:{{ if eq (len $tools.brew) 0 }} []{{ end }}
{{- range $tools.brew }}
      - {{ . }}
{{- end }}
    mise:{{ if eq (len $tools.mise) 0 }} []{{ end }}
{{- range $tools.mise }}
      - {{ . }}
{{- end }}
    node:{{ if eq (len $tools.node) 0 }} []{{ end }}
{{- range $tools.node }}
      - {{ . }}
{{- end }}
    uv:{{ if eq (len $tools.uv) 0 }} []{{ end }}
{{- range $tools.uv }}
      - {{ . }}
{{- end }}
