{{- $data := include ".chezmoidata/tools.yaml" | fromYaml }}

{{- $machine_name := promptStringOnce . "machine.name" "What is this machine's name" .chezmoi.hostname }}
{{- $username := promptStringOnce . "user.username" "What is your username" (base .chezmoi.homeDir) }}

{{- $machine := "desktop" }}
{{- $shell := "" }}
{{- if ne .chezmoi.os "windows" }}
  {{- $machines := (contains "microsoft" (.chezmoi.kernel.osrelease | lower)) | ternary (without $data.machines "server") $data.machines }}
  {{- $machine = promptChoiceOnce . "machine.kind" "What kind of machine is this (desktop: apps only, workstation: dev tooling, server: dev tooling + hostname/timezone)" $machines "workstation" }}
  {{- $shell = promptChoiceOnce . "shell" "Which shell will you be using" (list "bash" "zsh") "zsh" }}
{{- else }}
  {{- $shell = promptChoiceOnce . "shell" "Which shell will you be using" (list "git-bash" "powershell") "powershell" }}
{{- end }}
{{- $dev := ne $machine "desktop" }}

{{- $profile := promptChoiceOnce . "profile" "Which profile should apply to this machine" $data.profiles }}

{{- $gaming := false }}
{{- $wsl := false }}
{{- if eq .chezmoi.os "windows" }}
  {{- if eq $profile "home" }}
    {{- $gaming = promptBoolOnce . "gaming" "Is this a gaming machine" }}
  {{- end }}
  {{- $wsl = promptBoolOnce . "wsl" "Will you be using WSL" true }}
{{- end }}

{{- $ide := promptMultichoiceOnce . "ide" "What IDE are you using to develop" (list "intellij" "vscode" "zed") (list "vscode") }}

{{- $timezone := "UTC" }}
{{- if eq $machine "server" }}
  {{- $timezone = promptStringOnce . "machine.timezone" "Which timezone should this server use" "UTC" }}
{{- end }}

{{- $managers := $data.managers }}

{{- $tools := dict }}
{{- $bundle_summary := list }}
{{- range $manager := $managers }}
  {{- $_ := set $tools $manager (list) }}
  {{- $bundle_summary = append $bundle_summary (printf "%s: %s" $manager ((index $data.tools $manager) | join ", ")) }}
{{- end }}

{{- $agent_runtimes := list }}
{{- $container_engine := "" }}
{{- $container_runtimes := list }}
{{- $email := "" }}
{{- $git_ssh := false }}
{{- $plugins := list }}
{{- $sandboxes := list }}
{{- if $dev }}
  {{- $email = promptStringOnce . "user.email" "What is your committer email" }}

  {{- $git_ssh = promptBoolOnce . "git.ssh" "Would you like to sign commits with your SSH key" true }}
  {{- $agent_runtimes = promptMultichoiceOnce . "ai.runtimes" "Which agent runtimes will you be using" $data.agent_runtimes (index $data.default_agent_runtimes $profile) }}

  {{- if gt (len $agent_runtimes) 0 }}
    {{- $plugins = promptMultichoiceOnce . "ai.plugins" "Which agent plugin(s) would you like to install" $data.plugins (index $data.default_plugins $profile) }}
    {{- $sandboxes = promptMultichoiceOnce . "ai.sandboxes" "Which sandbox(es) should run the agent runtimes" $data.sandboxes (index $data.default_sandboxes $profile)  }}
  {{- end }}

  {{- $container_runtimes = promptMultichoiceOnce . "container.runtimes" "Which container runtime(s) would you like to install" $data.container_runtimes (index $data.default_container_runtimes $profile) }}
  {{- if eq (len $container_runtimes) 1 }}
    {{- $container_engine = first $container_runtimes | default "" }}
  {{- else }}
    {{- $container_engine = promptChoiceOnce . "container.engine" "Which container engine should tools default to" $container_runtimes }}
  {{- end }}

  {{- $_ := warnf "\navailable tools per manager:\n  %s" ($bundle_summary | join "\n  ") }}

  {{- $_ := set $tools "mise" (promptMultichoiceOnce . "tools.mise" "Which tools would you like to install via mise" (index $data.tools "mise") (index $data.default_tools $profile)) }}
{{- end -}}

umask: 0o22

# disable auto apply on 'chezmoi update' to let diff review before apply
update:
  apply: false

# disable scripts diff review (hides only their content)
# switching back to true won't be overridden with subsequent 'chezmoi init'
diff:
  scriptContents: {{ dig "diff" "scriptContents" (eq .chezmoi.os "windows") . }}

{{- if ne .chezmoi.os "windows" }}

# nix, home-manager, python and mise must exist before any source state read
hooks:
  read-source-state:
    pre:
      command: sh
      args: [{{ .chezmoi.sourceDir }}/scripts/bootstrap.sh]

# python built by scripts/bootstrap.sh
interpreters:
  py:
    command: {{ .chezmoi.homeDir }}/.local/state/chezmoi/env/bin/python3
{{- else }}

# the default execution policy refuses to run chezmoi's temporary .ps1 scripts
interpreters:
  ps1:
    command: powershell
    args: [-NoLogo, -ExecutionPolicy, Bypass, -File]
{{- end }}

data:
{{- if eq .chezmoi.os "windows" }}
  # Which work profile applies ('home' or 'soprasteria')
  profile: {{ $profile }}
  # Whether this is a gaming machine (adds EA, Epic, Steam, Ubisoft...)
  # This option only works when 'profile' is 'home' (obviously)
  gaming: {{ $gaming }}
  machine:
    # Name for this machine, used as the SSH key comment or server hostname
    name: {{ $machine_name }}

  user:
    # Username used as git committer and in the SSH key comment
    username: {{ $username }}

  # Which IDEs to install ('intellij', 'vscode', 'zed')
  ide:{{ if eq (len $ide) 0 }} []{{ else }}{{ $ide | toYaml | trim | nindent 4 }}{{ end }}
  # Default shell ('git-bash' or 'powershell')
  shell: {{ $shell }}
  # Whether to install and configure WSL
  wsl: {{ $wsl }}

  # Files to exclude from chezmoi generation, in case you'd want to own some
  #
  # Note that some files are by default merged, allowing you to enrich them without loosing custom changes on 'chezmoi apply'
  ignore:{{ with (dig "ignore" list .) }}{{ . | toYaml | trim | nindent 4 }}{{ else }} []{{ end }}
{{- else }}
  # Which work profile applies ('home' or 'soprasteria')
  profile: {{ $profile }}
  machine:
    # What kind of machine this is ('desktop', 'workstation', 'server')
    kind: {{ $machine }}
    # Name for this machine, used as the SSH key comment or server hostname
    name: {{ $machine_name }}
    # Timezone to define on the host when 'machine.kind' is 'server'
    timezone: {{ $timezone }}

  user:
    # Email to use as git committer
    email: {{ $email }}
    # Username used as git committer and in the SSH key comment
    username: {{ $username }}

  git:
    # Whether to sign commits with the SSH key
    ssh: {{ $git_ssh }}
  # Which IDEs to install ('intellij', 'vscode', 'zed')
  ide:{{ if eq (len $ide) 0 }} []{{ else }}{{ $ide | toYaml | trim | nindent 4 }}{{ end }}
  # Default shell ('bash' or 'zsh')
  shell: {{ $shell }}

  container:
    # Which container engine gitlab-ci-local should use
    engine: {{ $container_engine }}
    # Which container runtimes to install ({{ $data.container_runtimes | join ", " }})
    runtimes:{{ if eq (len $container_runtimes) 0 }} []{{ else }}{{ $container_runtimes | toYaml | trim | nindent 6 }}{{ end }}

  ai:
    # Which agent plugins to enable ({{ $data.plugins | join ", " }})
    #
    # When selected, the following plugins are installed on all choosen runtimes below
    plugins:{{ if eq (len $plugins) 0 }} []{{ else }}{{ $plugins | toYaml | trim | nindent 6 }}{{ end }}
    # Which AI agent runtimes to install ({{ $data.agent_runtimes | join ", " }})
    runtimes:{{ if eq (len $agent_runtimes) 0 }} []{{ else }}{{ $agent_runtimes | toYaml | trim | nindent 6 }}{{ end }}
    # Which sandboxes to run the agents in ({{ $data.sandboxes | join ", " }})
    #
    # Even when on, agents do not run by default in sandboxes, please see the README
    sandboxes:{{ if eq (len $sandboxes) 0 }} []{{ else }}{{ $sandboxes | toYaml | trim | nindent 6 }}{{ end }}

  # Files to exclude from chezmoi generation, in case you'd want to own some
  #
  # Note that some files are by default merged, allowing you to enrich them without loosing custom changes on 'chezmoi apply'
  ignore:{{ with (dig "ignore" list .) }}{{ . | toYaml | trim | nindent 4 }}{{ else }} []{{ end }}

  # Which tool bundles to install
  #
  # available tools per manager:
  {{- range $bundle_summary }}
  #   - {{ . }}
  {{- end }}
  tools:
{{- range $manager := $managers }}
    {{ $manager }}:{{ if eq (len (index $tools $manager)) 0 }} []{{ else }}{{ index $tools $manager | toYaml | trim | nindent 6 }}{{ end }}
{{- end }}
{{- end }}
