{{- $data := include ".chezmoidata/tools.yaml" | fromYaml }}

{{- $machine := "desktop" }}
{{- if ne .chezmoi.os "windows" }}
  {{- $machine = promptChoiceOnce . "machine.kind" "What kind of machine is this (desktop: apps only, workstation: dev tooling, server: dev tooling + hostname/timezone)" $data.machines "workstation" }}
{{- end }}
{{- $dev := ne $machine "desktop" }}

{{- $profile := promptChoiceOnce . "profile" "Which profile should apply to this machine" $data.profiles }}

{{- $gaming := false }}
{{- if and (eq $profile "home") (eq .chezmoi.os "windows") }}
  {{- $gaming = promptBoolOnce . "gaming" "Is this a gaming machine" }}
{{- end }}

{{- $shell := "powershell" }}
{{- if ne .chezmoi.os "windows" }}
  {{- $shell = promptChoiceOnce . "shell" "Which shell will you be using" (list "bash" "zsh") "zsh" }}
{{- end }}

{{- $ide := promptMultichoiceOnce . "ide" "What IDE are you using to develop" (list "intellij" "vscode" "zed") (list "vscode") }}

{{- $ssh_generate := promptBoolOnce . "ssh.generate" "Would you like to generate an SSH key" true }}
{{- $machine_name := "" }}
{{- if or $ssh_generate (eq $machine "server") }}
  {{- $machine_name = promptStringOnce . "machine.name" "What is this machine's name" .chezmoi.hostname }}
{{- end }}

{{- $timezone := "" }}
{{- if eq $machine "server" }}
  {{- $timezone = promptStringOnce . "ansible.timezone" "Which timezone should this server use" "UTC" }}
{{- end }}

{{- $email := "" }}
{{- $username := "" }}
{{- if or $dev $ssh_generate }}
  {{- $username = promptStringOnce . "user.username" "What is your committer username" .chezmoi.username }}
  {{- $email = promptStringOnce . "user.email" "What is your committer email" }}
{{- end }}

{{- $managers := $data.managers }}

{{- $tools := dict }}
{{- $bundle_summary := list }}
{{- range $manager := $managers -}}
  {{- $_ := set $tools $manager (list) }}
  {{- $bundle_summary = append $bundle_summary (printf "%s: %s" $manager ((index $data.tools $manager) | join ", ")) }}
{{- end -}}

# available agent runtimes: {{ $data.agent_runtimes | join ", " }}
# available agent plugins: {{ $data.plugins | join ", " }}
# available containers: {{ $data.container_runtimes | join ", " }}
# available tools_management: {{ $managers | join ", " }}
# available tools per manager:
{{- range $bundle_summary }}
#   - {{ . }}
{{- end }}

{{- $agent_runtimes := list }}
{{- $container_engine := "" }}
{{- $container_runtimes := list }}
{{- $git_ssh := false }}
{{- $plugins := list }}
{{- $tools_management := list }}
{{- if $dev }}
  {{- $git_ssh = promptBoolOnce . "git.ssh" "Would you like to sign commits with your SSH key" true }}
  {{- $agent_runtimes = promptMultichoiceOnce . "ai.runtimes" "Which agent runtimes will you be using" $data.agent_runtimes (index $data.default_agent_runtimes $profile) }}

  {{- if gt (len $agent_runtimes) 0 }}
    {{- $plugins = promptMultichoiceOnce . "ai.plugins" "Which agent plugin(s) would you like to install" $data.plugins (index $data.default_plugins $profile) }}
  {{- end }}

  {{- $container_runtimes = promptMultichoiceOnce . "container.runtimes" "Which container runtime(s) would you like to install" $data.container_runtimes (index $data.default_container_runtimes $profile) }}
  {{- if eq (len $container_runtimes) 1 }}
    {{- $container_engine = first $container_runtimes | default "" }}
  {{- else }}
    {{- $container_engine = promptChoiceOnce . "container.engine" "Which container engine should tools default to" $container_runtimes }}
  {{- end }}

  {{- $_ := warnf "available tools per manager:\n  %s" ($bundle_summary | join "\n  ") }}

  {{- $tools_management = promptMultichoiceOnce . "tools_management" "Which tool manager(s) would you like to use" $managers (index $data.default_managers $profile) }}

  {{- range $manager := $tools_management }}
    {{- $_ := set $tools $manager (promptMultichoiceOnce $
        (print "tools." $manager)
        (print "Which tools would you like to install via " $manager)
        (index $data.tools $manager) (index $data.default_tools $profile)) }}
  {{- end }}
{{- end }}

umask: 0o22

{{- if ne .chezmoi.os "windows" }}

# custom pager for ansible check integration, verbose apply and ansible skip with '-x scripts'
diff:
  pager: {{ .chezmoi.sourceDir }}/scripts/pager.sh

# ansible integration with chezmoi
hooks:
  apply:
    pre:
      command: {{ .chezmoi.sourceDir }}/scripts/pre-chezmoi.sh
    post:
      command: {{ .chezmoi.sourceDir }}/scripts/ansible.sh
  diff:
    pre:
      command: {{ .chezmoi.sourceDir }}/scripts/pre-chezmoi.sh
    post:
      # handle cases where there's no chezmoi diff or --no-pager argument is provided
      command: {{ .chezmoi.sourceDir }}/scripts/post-diff.sh
{{- end }}

data:
  ai:
    runtimes:{{ $agent_runtimes | toYaml | trim | nindent 6 }}
    plugins:{{ $plugins | toYaml | trim | nindent 6 }}
{{- if ne .chezmoi.os "windows" }}
  # machine facts for the ansible playbook, gathered here so the play skips gather_facts and stays root-only
  ansible:
    codename: {{ .chezmoi.osRelease.versionCodename }}
    home: {{ .chezmoi.homeDir }}
    timezone: {{ $timezone }}
    username: {{ .chezmoi.username }}
{{- end }}
  container:
    engine: {{ $container_engine }}
    runtimes:{{ $container_runtimes | toYaml | trim | nindent 6 }}
  gaming: {{ $gaming }}
  git:
    ssh: {{ $git_ssh }}
  ide:{{ $ide | toYaml | trim | nindent 4 }}
  machine:
    kind: {{ $machine }}
    name: {{ $machine_name }}
  profile: {{ $profile }}
  shell: {{ $shell }}
  ssh:
    generate: {{ $ssh_generate }}
  tools:
{{- range $manager := $managers }}
    {{ $manager }}:{{ index $tools $manager | toYaml | trim | nindent 6 }}
{{- end }}
  tools_management:{{ $tools_management | toYaml | trim | nindent 4 }}
  user:
    email: {{ $email }}
    username: {{ $username }}
