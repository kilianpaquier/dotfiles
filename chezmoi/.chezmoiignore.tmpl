{{- if eq .chezmoi.os "windows" }}
**/*.sh
.config/environment.d
.config/home-manager
{{- else }}
.inputrc
**/*.ps1
{{- end }}

{{ includeTemplate "chezmoiignore.tmpl" . }}

{{- if not .ssh.generate }}
.chezmoiscripts/*-ssh.sh
.chezmoiscripts/*-ssh.ps1
{{- end }}

{{- if or (not .ssh.generate) (eq .chezmoi.os "windows") }}
.ssh
{{- end }}

{{- if eq (len .ai.runtimes) 0 }}
.chezmoiscripts/*-ai.sh
.chezmoiscripts/*-ai-hooks.sh
{{- end }}

{{- if not (has "mise" .tools_management) }}
.chezmoiscripts/*-mise.sh
{{- end }}

{{- if not (or (eq .machine.kind "server") (and (eq .machine.kind "desktop") (eq .profile "home"))) }}
.chezmoiscripts/*-system.sh
{{- end }}

{{- if eq .chezmoi.os "windows" }}
.config/environment.d/bash.conf
.bash_aliases
.bash_logout
.bashenv
.bashrc
.profile
{{- end }}

# partials
**/*.partial.*

# source-only directories, reached through .chezmoi.sourceDir
scripts
