{{- if or (eq .chezmoi.os "windows") (eq .machine.kind "desktop") }}
.claude
.config/git/config
.config/git/ignore
.copilot
workspaces
{{- end }}

{{- if eq .chezmoi.os "windows" }}
# Windows
.chezmoiscripts/linux/**
.config/chezmoi/home.local.nix
.gnupg
.ssh
{{- end }}

{{- if eq .chezmoi.os "linux" }}
# Linux
.chezmoiscripts/windows/**

{{- if eq (len .ai.runtimes) 0 }}
.chezmoiscripts/linux/*-agent-plugins.sh
{{- end }}

{{- if has "sbx" .ai.sandboxes }}
.chezmoiscripts/linux/*-sbx-reset.sh
{{- end }}

{{- if gt (len .ai.runtimes) 0 }}
.chezmoiscripts/linux/*-herdr-stop.sh
{{- end }}

{{- if or (eq (len .ai.runtimes) 0) (not (has "rtk" .tools.mise)) }}
.chezmoiscripts/linux/*-rtk-install.sh
{{- end }}

{{- if has "rtk" .tools.mise }}
.chezmoiscripts/linux/*-rtk-uninstall.sh
{{- end }}
{{- end }}

{{- $ignore_file := joinPath .chezmoi.homeDir ".config/chezmoi/chezmoiignore" }}
{{- if stat $ignore_file }}
{{- range include $ignore_file | splitList "\n" }}{{- if not (hasPrefix "/" .) }}{{ . }}{{- end }}{{- end }}
{{- end }}

{{ includeTemplate "deselected.tmpl" . }}

# partials
**/*.partial.*

# source-only directories, reached through .chezmoi.sourceDir
scripts
