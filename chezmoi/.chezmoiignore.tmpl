{{- if eq .chezmoi.os "windows" }}
.chezmoiscripts/linux
.bash_aliases
.bash_logout
.bashenv
.bashrc
.config/environment.d
.config/gopass
.config/home-manager
.gnupg
.profile
.ssh
{{- else }}
.chezmoiscripts/windows
AppData
.config/git/git-prompt.sh
.inputrc
.wslconfig
{{- if not (contains "microsoft" (.chezmoi.kernel.osrelease | lower)) }}
.chezmoiscripts/linux/*-wsl.sh
{{- end }}
{{- end }}

{{ includeTemplate "chezmoiignore.tmpl" . }}

{{- if not .ssh.generate }}
.chezmoiscripts/linux/*-ssh.sh
.chezmoiscripts/windows/*-ssh.ps1
.ssh
{{- end }}

{{- if eq (len .ai.runtimes) 0 }}
.chezmoiscripts/linux/*-ai.sh
.chezmoiscripts/linux/*-ai-hooks.sh
{{- end }}

{{- if not (has "mise" .tools_management) }}
.chezmoiscripts/linux/*-mise.sh
{{- end }}

{{- if not (has "k8s" .tools.mise) }}
.kube
{{- end }}

{{- if eq .machine.kind "desktop" }}
.gitconfig
{{- end }}

{{- $system := or (has "docker" .container.runtimes) (eq .machine.kind "server") (and (eq .machine.kind "desktop") (eq .profile "home")) }}
{{- if not $system }}
.chezmoiscripts/linux/*-system.sh
{{- end }}

{{- if not .wsl }}
.chezmoiscripts/windows/*-wsl.ps1
.wslconfig
{{- end }}

# partials
**/*.partial.*

# source-only directories, reached through .chezmoi.sourceDir
scripts
