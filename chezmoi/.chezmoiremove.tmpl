# Force remove side directories not chezmoi managed.

{{- if ne .chezmoi.os "windows" }}
.config/home-manager/scripts
.config/wsl

{{- if eq (len .ai.runtimes) 0 }}
.agents
.apm-local
.cache/apm
{{- end }}

{{- if not (has "claude" .ai.runtimes) }}
.cache/claude
.cache/claude-cli-nodejs
.claude.json*
.local/share/claude
.local/state/claude
{{- end }}

{{- if not (has "copilot" .ai.runtimes) }}
.cache/copilot
{{- end }}

{{- if not (has "nono" .ai.sandboxes) }}
.local/state/nono
{{- end }}

{{- if not (has "sbx" .ai.sandboxes) }}
.cache/sandboxes
.local/share/sandboxes
.local/state/sandboxes
{{- end }}

{{- if not (has "mise" .tools_management) }}
.cache/mise
.local/share/mise
.local/state/mise
{{- end }}

{{- if not (has "bun" .tools.mise) }}
.bun
{{- end }}

{{- if not (has "context7" .tools.mise) }}
.local/state/context7
{{- end }}

{{- if not (has "destructive-command-guard" .tools.mise) }}
.cache/dcg
.local/state/dcg
{{- end }}

{{- if not (has "gh" .tools.mise) }}
.cache/gh
.local/state/gh
{{- end }}

{{- if not (has "glab" .tools.mise) }}
.cache/glab-cli
{{- end }}

{{- if not (has "go" .tools.mise) }}
.cache/go-build
.cache/golangci-lint
.cache/goimports
.cache/gopls
{{- end }}

{{- if not (has "hugo" .tools.mise) }}
.cache/hugo_cache
{{- end }}

{{- if not (has "incus" .tools.mise) }}
.cache/incus
.config/incus
{{- end }}

{{- if not (has "java" .tools.mise) }}
.gradle/caches
.gradle/wrapper
.m2/repository
{{- end }}

{{- if not (has "k8s" .tools.mise) }}
.cache/helm
.krew
{{- end }}

{{- if not (has "kotlin" .tools.mise) }}
.kotlin
{{- end }}

{{- if not (has "mempalace" .tools.mise) }}
.config/mempalace
.mempalace
{{- end }}

{{- if not (has "pre-commit" .tools.mise) }}
.cache/pre-commit
.cache/pre-commit-zipapp
{{- end }}

{{- if not (has "rtk" .tools.mise) }}
.local/share/rtk
{{- end }}

{{- if not (or (has "opentofu" .tools.mise) (has "terraform" .tools.mise)) }}
.cache/terraform
.cache/tflint
.terraform.d
{{- end }}

{{- if not (has "uv" .tools.mise) }}
.cache/uv
.local/share/uv
{{- end }}

{{- if not (has "docker" .container.runtimes) }}
.config/docker
{{- end }}

{{- if not (has "podman" .container.runtimes) }}
.cache/containers
{{- end }}

{{- if ne .shell "zsh" }}
.cache/gitstatus
.cache/zsh
.cache/zsh4humans
.zshenv
{{- end }}
{{- end }}
