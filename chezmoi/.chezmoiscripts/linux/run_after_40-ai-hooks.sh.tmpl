#!/bin/sh

set -e

# shellcheck disable=SC1091
[ ! -f "$HOME/.profile" ] || . "$HOME/.profile"

{{- if has "rtk" .tools.mise }}

if command -v rtk >/dev/null 2>&1; then
{{- if has "copilot" .ai.runtimes }}
  if [ ! -f "$HOME/.copilot/hooks/rtk-rewrite.json" ]; then
    rtk init -g --copilot --auto-patch
  fi
{{- end }}
{{- if has "claude" .ai.runtimes }}
  if ! grep -qs 'rtk hook claude' "$HOME/.claude/settings.json"; then
    rtk init -g --auto-patch
  fi
{{- end }}
{{- if has "codex" .ai.runtimes }}
  if ! grep -qs 'rtk hook codex' "$HOME/.codex/hooks.json"; then
    rtk init -g --codex
  fi
{{- end }}
fi
{{- end }}

{{- if has "boost" .tools.mise }}

if command -v boost >/dev/null 2>&1; then
{{- if has "copilot" .ai.runtimes }}
  if [ ! -f "$HOME/.copilot/hooks/boost.json" ]; then
    boost init --accept-terms --copilot
  fi
{{- end }}
{{- if has "claude" .ai.runtimes }}
  if ! grep -qs boost-hook-claude "$HOME/.claude/settings.json"; then
    boost init --accept-terms --claude
  fi
{{- end }}
{{- if has "codex" .ai.runtimes }}
  if ! grep -qs boost-hook-codex "$HOME/.codex/hooks.json"; then
    boost init --accept-terms --codex
  fi
{{- end }}
fi
{{- end }}
