{{- $ignore := list }}
{{- $ignore_file := joinPath .chezmoi.homeDir ".config/chezmoi/.chezmoiignore" }}
{{- if stat $ignore_file }}{{ $ignore = include $ignore_file | splitList "\n" }}{{- end -}}

#!/bin/sh

set -e

# systemd: {{ if stat "/run/systemd/system" }}running{{ else }}off{{ end }}
# sourced scripts: {{ list (include "scripts/log.sh") (include "scripts/pkg.sh") (include "scripts/sudo.sh") | join "" | sha256sum }}

# shellcheck disable=SC1091
[ ! -f "$HOME/.profile" ] || . "$HOME/.profile"

# shellcheck disable=SC1091
. "{{ .chezmoi.sourceDir }}/scripts/log.sh"

# shellcheck disable=SC1091
. "{{ .chezmoi.sourceDir }}/scripts/pkg.sh"

# shellcheck disable=SC1091
. "{{ .chezmoi.sourceDir }}/scripts/sudo.sh"

# paths listed in ~/.config/chezmoi/.chezmoiignore, whose writes are skipped
ignored() {
  case " {{ range $ignore }}{{ if hasPrefix "/" . }}{{ . }} {{ end }}{{ end }}" in
  *" $1 "*) return 0 ;;
  esac
  return 1
}

# root-only setup home-manager cannot own: system daemons and host identity

{{- if and (eq .machine.kind "desktop") (eq .profile "home") }}

# PC/SC daemon for yubioath-flutter
pcscd() {
  if [ ! -d /run/systemd/system ]; then
    warn "systemd isn't running, skipping pcscd socket activation"
    return 0
  fi

  # is-enabled also fails while the package is missing
  if systemctl is-enabled --quiet pcscd.socket 2>/dev/null; then
    return 0
  fi

  if ! pkg_install pcscd pcsc-lite pcsclite; then
    warn "pcscd is missing, yubioath-flutter can't reach the YubiKey, install pcscd (apt), pcsc-lite (dnf) or pcsclite (pacman) as root"
    return 0
  fi

  if ! sudo_run systemctl enable --now pcscd.socket; then
    warn "pcscd.socket isn't enabled, yubioath-flutter can't reach the YubiKey, run as root: systemctl enable --now pcscd.socket"
  fi
}
pcscd
{{- end }}

{{- if gt (len .container.runtimes) 0 }}

{{ include ".chezmoitemplates/linux/rootless-containers.sh" | trim }}
{{- end }}

{{- if eq .machine.kind "server" }}

{{ includeTemplate "linux/server-identity.sh" . | trim }}
{{- end }}

{{- if contains "microsoft" (.chezmoi.kernel.osrelease | lower) }}

pkg_install dbus-user-session - dbus ||
  warn "D-Bus user session is missing, gopass secret-service (gh, glab, registry logins) can't run, install dbus-user-session (apt) or dbus (pacman) as root"
pkg_install openssh-client openssh-clients openssh ||
  warn "OpenSSH client is missing, SSH keys and SSH commit signing don't work, install openssh-client (apt), openssh-clients (dnf) or openssh (pacman) as root"
pkg_install uidmap shadow-utils shadow ||
  warn "uidmap is missing, rootless containers can't start, install uidmap (apt), shadow-utils (dnf) or shadow (pacman) as root"

{{- if not (has "/etc/wsl.conf" $ignore) }}

wsl_config() {
  wsl_conf=$(cat <<'EOF'
{{ includeTemplate "wsl.conf.tmpl" . | trim }}
EOF
)

  if [ "$(cat /etc/wsl.conf 2>/dev/null)" = "$wsl_conf" ]; then
    return 0
  fi

  if ! sudo_write /etc/wsl.conf "$wsl_conf"; then
    warn "/etc/wsl.conf differs from .chezmoitemplates/wsl.conf.tmpl, without its systemd = true no user service runs (docker, gopass agents, resource limits), write it as root"
    return 0
  fi

  info "wsl.conf updated, run 'wsl.exe --shutdown' from Windows and reopen this distro to apply"
}
wsl_config
{{- end }}
{{- end }}
