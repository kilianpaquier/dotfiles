#!/bin/sh

set -e

# herdr selected: {{ gt (len .ai.runtimes) 0 }}

# shellcheck disable=SC1091
[ ! -f "$HOME/.profile" ] || . "$HOME/.profile"

# the stop goes before mise prunes the binary, the server would keep running without it
if command -v herdr >/dev/null 2>&1 && [ -S "$HOME/.config/herdr/herdr.sock" ]; then
  herdr server stop
fi
