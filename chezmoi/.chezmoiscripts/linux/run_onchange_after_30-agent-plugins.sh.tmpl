#!/bin/sh

set -e

# date: {{ now | date "2006-01-02T15" }}
# plugins config: {{ list
  (includeTemplate "plugins.json.tmpl" (merge (dict "lsps" true) .))
  (include "dot_apm/apm.yml.tmpl") | join "" | sha256sum }}

# shellcheck disable=SC1091
[ ! -f "$HOME/.profile" ] || . "$HOME/.profile"

{{- if has "claude" .ai.runtimes }}

disabled="{{ range $id, $on := includeTemplate "plugins.json.tmpl" (merge (dict "lsps" true) .) | fromJson }}{{ if not $on }} {{ $id }}{{ end }}{{ end }}"
{{ include ".chezmoitemplates/linux/claude-plugins.sh" | trim }}
{{- end }}

{{- if has "copilot" .ai.runtimes }}

disabled="{{ range $id, $on := includeTemplate "plugins.json.tmpl" (merge (dict "lsps" false) .) | fromJson }}{{ if not $on }} {{ $id }}{{ end }}{{ end }}"
{{ include ".chezmoitemplates/linux/copilot-plugins.sh" | trim }}
{{- end }}

# install is idempotent, and rewrites each hook script to the installed herdr version
{{- range .ai.runtimes }}
herdr integration install {{ . }}
{{- end }}
apm update -g -y
