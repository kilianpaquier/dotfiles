#!/bin/sh

# hourly run: {{ now | date "2006-01-02T15" }}
# immediate run on plugin or marketplace change: {{ list (includeTemplate "plugins.json.tmpl" (merge (dict "lsps" true) .)) (include "dot_claude/settings.partial.json") (include "dot_copilot/settings.partial.json") | join "" | sha256sum }}

set -e

# shellcheck disable=SC1091
[ ! -f "$HOME/.profile" ] || . "$HOME/.profile"

{{- if has "claude" .ai.runtimes }}

# extraKnownMarketplaces only get cloned by an interactive session, the plugin CLI ignores them.
known=" $(claude plugin marketplace list --json | jq -r '.[].name' | tr '\n' ' ')"
jq -r '.extraKnownMarketplaces | to_entries[] | .key + " " + .value.source.repo' "$HOME/.claude/settings.json" | while read -r name repo; do
  case "$known" in *" $name "*) continue ;; esac
  claude plugin marketplace add "$repo" || true
done
claude plugin marketplace update || true

installed=" $(claude plugin list --json | jq -r '.[].id' | tr '\n' ' ')"
for plugin in $(jq -r '.enabledPlugins | to_entries[] | select(.value) | .key' "$HOME/.claude/settings.json"); do
  case "$installed" in *" $plugin "*) continue ;; esac
  claude plugin install "$plugin" || true
done
for plugin in $(jq -r '.enabledPlugins | to_entries[] | select(.value | not) | .key' "$HOME/.claude/settings.json"); do
  case "$installed" in *" $plugin "*) claude plugin uninstall "$plugin" || true ;; esac
done
claude plugin list --json | jq -r '.[].id' | xargs -r -n1 claude plugin update -y
{{- end }}

{{- if has "codex" .ai.runtimes }}

codex plugin marketplace upgrade
{{- end }}

{{- if has "copilot" .ai.runtimes }}

copilot plugin marketplace update

installed=" $(copilot plugin list --json | jq -r '.[] | .name + "@" + .marketplace' | tr '\n' ' ')"
for plugin in $(jq -r '.enabledPlugins | to_entries[] | select(.value) | .key' "$HOME/.copilot/settings.json"); do
  case "$installed" in *" $plugin "*) continue ;; esac
  copilot plugin install "$plugin" || true
done
for plugin in $(jq -r '.enabledPlugins | to_entries[] | select(.value | not) | .key' "$HOME/.copilot/settings.json"); do
  case "$installed" in *" $plugin "*) copilot plugin uninstall "$plugin" || true ;; esac
done
copilot plugin update --all
{{- end }}

apm update -g -y
