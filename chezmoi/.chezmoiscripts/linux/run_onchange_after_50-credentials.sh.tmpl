#!/bin/sh

set -eu

# shellcheck disable=SC1091
[ ! -f "$HOME/.profile" ] || . "$HOME/.profile"

# shellcheck disable=SC1091
. "{{ .chezmoi.sourceDir }}/scripts/log.sh"

{{ includeTemplate "ssh.sh.tmpl" . | trim }}

{{- if ne .machine.kind "desktop" }}

# init the default gopass store, age asks the passphrase protecting its new identity
store="${XDG_DATA_HOME:-$HOME/.local/share}/gopass/stores/root"

if [ ! -f "$store/.age-recipients" ]; then
  gopass setup --crypto age --storage fs

  # unlock the agent, then list the identities so gopass caches their recipients and later writes need no passphrase
  if gopass age agent unlock && gopass age identities >/dev/null; then :; else
    warn "gopass wasn't unlocked, run 'gopass age agent unlock' after login"
  fi
fi
{{- end }}
