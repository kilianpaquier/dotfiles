#!/bin/sh

set -e

# shellcheck disable=SC1091
[ ! -f "$HOME/.profile" ] || . "$HOME/.profile"

# shellcheck disable=SC1091
. "{{ .chezmoi.sourceDir }}/scripts/log.sh"

# setup wsl.conf within the WSL distribution

if ! cmp -s "$HOME/.config/wsl/wsl.conf" /etc/wsl.conf; then
  sudo install -m 644 "$HOME/.config/wsl/wsl.conf" /etc/wsl.conf
  info "wsl.conf updated, run 'wsl.exe --shutdown' from Windows and reopen this distro to apply"
fi
