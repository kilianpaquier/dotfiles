#!/bin/sh

set -e

# shellcheck disable=SC1091
[ ! -f "$HOME/.profile" ] || . "$HOME/.profile"

# shellcheck disable=SC1091
. "{{ .chezmoi.sourceDir }}/scripts/log.sh"

# root-only setup home-manager cannot own: system daemons and host identity

{{- if and (eq .machine.kind "desktop") (eq .profile "home") }}

# PC/SC daemon for yubioath-flutter
sudo apt-get update && sudo apt-get install -y pcscd
{{- end }}

{{- if has "docker" .container.runtimes }}

# uidmap provides newuidmap/newgidmap, needed by rootless docker's user namespace
if ! grep -q "^$USER:" /etc/subuid 2>/dev/null || ! grep -q "^$USER:" /etc/subgid 2>/dev/null; then
  if ! command -v newuidmap >/dev/null 2>&1 || ! command -v newgidmap >/dev/null 2>&1; then
    sudo apt-get update && sudo apt-get install -y uidmap
  fi
fi

# rootless docker's systemd user service needs linger to start at boot and survive logout
if [ "$(loginctl show-user "$USER" -p Linger --value 2>/dev/null)" != "yes" ]; then
  # a cancelled or repeatedly-wrong sudo prompt must not abort the rest of the setup
  trap ':' INT
  sudo loginctl enable-linger "$USER" || warn "failed to enable linger for rootless docker, skipping"
  trap - INT
fi
{{- end }}

{{- if eq .machine.kind "server" }}

hostname=$(hostname)
if [ "$hostname" != "{{ .machine.name }}" ]; then
  # hostnamectl leaves /etc/hosts alone, replace the whitespace-bounded old name
  sed -E "s#(^|\s)$hostname(\s|$)#\1{{ .machine.name }}\2#g" /etc/hosts | sudo tee /etc/hosts >/dev/null
  sudo hostnamectl set-hostname "{{ .machine.name }}"
fi

timezone=$(timedatectl show -p Timezone --value)
if [ "$timezone" != "{{ .machine.timezone }}" ]; then
  sudo timedatectl set-timezone "{{ .machine.timezone }}"
  # long-running daemons cache the timezone
  for service in cron rsyslog; do
    ! systemctl is-active --quiet "$service" || sudo systemctl restart "$service"
  done
fi
{{- end }}
