#!/bin/sh

set -e

# install.sh aborts when stdin is not a terminal, hence the command substitution instead of a pipe
if ! command -v brew >/dev/null 2>&1; then
  NONINTERACTIVE=1 bash -c "$(curl -fSL https://raw.githubusercontent.com/Homebrew/install/main/install.sh)"
fi

brew update
brew bundle install --file="$HOME/.Brewfile"
brew bundle cleanup --file="$HOME/.Brewfile" --force
