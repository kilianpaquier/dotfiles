#!/bin/sh

set -e

{{- if has "mise" .tools_management }}

if ! command -v mise >/dev/null 2>&1; then
  curl -fSL https://mise.run | MISE_INSTALL_PATH=$HOME/.local/bin/mise sh
fi

mise self-update -y
mise install -y
mise upgrade -y
mise prune -y
mise reshim --force -y
{{- else }}

if command -v mise >/dev/null 2>&1; then
  mise implode -y
fi
{{- end }}
