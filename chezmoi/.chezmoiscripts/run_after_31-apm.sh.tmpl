#!/bin/sh

set -e

{{- if has "copilot" .agents }}

if command -v uvx >/dev/null 2>&1; then
  # temporarily use a custom branch to get user-scope instructions correctly under ~/.copilot/instructions
  uvx --from "git+https://github.com/kilianpaquier/apm@fix/copilot-user-scope-instructions" apm update -g -y
else
  echo "tool 'uv' is needed to handle copilot global instructions with APM"
fi
{{- else }}
apm update -g -y
{{- end }}
