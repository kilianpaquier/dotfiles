# handle .gitconfig through a script to avoid merging issues (where many will change it for their own aliases or preferences)

if (-not (Get-Command git -ErrorAction SilentlyContinue)) {
  winget install -e -i Git.Git
}

{{- if .user.username }}

git config --global user.name '{{ .user.username }}'
git config --global user.email '{{ .user.email }}'
{{- end }}

git config --global init.defaultbranch main
git config --global push.autoSetupRemote true
{{- if has "vscode" .ide }}
git config --global core.editor 'code --wait'
{{- else }}
git config --global --unset core.editor; $LASTEXITCODE = 0
{{- end }}

{{- if .git.ssh }}

git config --global commit.gpgsign true
git config --global gpg.format ssh
git config --global gpg.ssh.defaultKeyCommand 'ssh-add -L'
git config --global tag.gpgsign true
{{- else }}

git config --global commit.gpgsign false
git config --global --unset gpg.format; $LASTEXITCODE = 0
git config --global --unset gpg.ssh.defaultKeyCommand; $LASTEXITCODE = 0
git config --global tag.gpgsign false
{{- end }}
