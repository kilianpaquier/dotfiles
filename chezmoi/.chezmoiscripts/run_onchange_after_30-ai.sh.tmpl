#!/bin/sh

set -e

{{- $mempalace := or (has "mempalace" .tools.mise) (has "mempalace" .tools.uv) }}
{{- $context7 := or (has "context7" .tools.mise) (has "context7" .tools.node) }}
{{- $caveman := has "caveman" .ai.plugins }}
{{- $ponytail := has "ponytail" .ai.plugins }}

{{- $go := or (has "go" .tools.brew) (has "go" .tools.mise) }}
{{- $java := or (has "java" .tools.brew) (has "java" .tools.mise) }}
{{- $kotlin := or (has "kotlin" .tools.brew) (has "kotlin" .tools.mise) }}
{{- $opentofu := or (has "opentofu" .tools.brew) (has "opentofu" .tools.mise) }}
{{- $shell := or (has "shell" .tools.brew) (has "shell" .tools.mise) (has "shell" .tools.node) }}
{{- $terraform := or (has "terraform" .tools.brew) (has "terraform" .tools.mise) }}
{{- $typescript := or (has "typescript" .tools.brew) (has "typescript" .tools.mise) (has "typescript" .tools.node) }}

{{- if has "claude" .ai.agents }}

{{- if $mempalace }}

claude plugin marketplace add mempalace/mempalace
claude plugin install mempalace@mempalace
{{- end }}

{{- if $caveman }}

claude plugin marketplace add JuliusBrussee/caveman
claude plugin install caveman@caveman
{{- end }}

{{- if $ponytail }}

claude plugin marketplace add DietrichGebert/ponytail
claude plugin install ponytail@ponytail
{{- end }}

claude plugin marketplace add kilianpaquier/ai-integration
{{- if has "codebase-memory-mcp" .tools.mise }}
claude plugin install codebase-memory-mcp@one-for-all
{{- end }}
{{- if has "codegraph" .tools.mise }}
claude plugin install codegraph@one-for-all
{{- end }}
{{- if $context7 }}
claude plugin install context7@one-for-all
{{- end }}
claude plugin install protected-paths@one-for-all
claude plugin install schema-converter@one-for-all

claude plugin marketplace add piebald-ai/claude-code-lsps
{{- if $shell }}
claude plugin install bash-language-server@claude-code-lsps
{{- end }}
{{- if $go }}
claude plugin install gopls@claude-code-lsps
{{- end }}
{{- if $java }}
claude plugin install jdtls@claude-code-lsps
{{- end }}
{{- if $kotlin }}
claude plugin install kotlin-lsp@claude-code-lsps
{{- end }}
{{- if $terraform }}
claude plugin install terraform-ls@claude-code-lsps
{{- end }}
{{- if $opentofu }}
claude plugin install tofu-ls@claude-code-lsps
{{- end }}
{{- if $typescript }}
claude plugin install typescript-language-server@claude-code-lsps
{{- end }}
{{- end }}

{{- if has "copilot" .ai.agents }}
{{- if $mempalace }}

copilot plugin marketplace add mempalace/mempalace || true
copilot plugin install mempalace@mempalace
{{- end }}

{{- if $caveman }}

copilot plugin marketplace add JuliusBrussee/caveman || true
copilot plugin install caveman@caveman
{{- end }}

{{- if $ponytail }}

copilot plugin marketplace add DietrichGebert/ponytail || true
copilot plugin install ponytail@ponytail
{{- end }}

copilot plugin marketplace add kilianpaquier/ai-integration || true
{{- if has "codebase-memory-mcp" .tools.mise }}
copilot plugin install codebase-memory-mcp@one-for-all
{{- end }}
{{- if has "codegraph" .tools.mise }}
copilot plugin install codegraph@one-for-all
{{- end }}
{{- if $context7 }}
copilot plugin install context7@one-for-all
{{- end }}
copilot plugin install protected-paths@one-for-all
copilot plugin install schema-converter@one-for-all
{{- end }}
