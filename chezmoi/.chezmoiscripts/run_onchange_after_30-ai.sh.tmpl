#!/bin/sh

set -e

{{- $plugins := dict
    "caveman@one-for-all" (has "caveman" .ai.plugins)
    "code-simplifier@one-for-all" true
    "codebase-memory-mcp@one-for-all" (has "codebase-memory-mcp" .tools.mise)
    "codegraph@one-for-all" (has "codegraph" .tools.mise)
    "context7@one-for-all" (or (has "context7" .tools.mise) (has "context7" .tools.node))
    "dcg@one-for-all" (or (has "destructive-command-guard" .tools.brew) (has "destructive-command-guard" .tools.mise))
    "exam-drill@one-for-all" true
    "feature-dev@one-for-all" true
    "mempalace@mempalace" (or (has "mempalace" .tools.mise) (has "mempalace" .tools.uv))
    "ponytail@ponytail" (has "ponytail" .ai.plugins)
    "protected-paths@one-for-all" true
    "schema-converter@one-for-all" true }}
{{- /* claude-code-lsps has no codex or copilot support, only claude receives those plugins */ -}}
{{- $lsps := dict
    "bash-language-server@claude-code-lsps" (or (has "shell" .tools.brew) (has "shell" .tools.mise))
    "gopls@claude-code-lsps" (or (has "go" .tools.brew) (has "go" .tools.mise))
    "jdtls@claude-code-lsps" (or (has "java" .tools.brew) (has "java" .tools.mise))
    "kotlin-lsp@claude-code-lsps" (or (has "kotlin" .tools.brew) (has "kotlin" .tools.mise))
    "terraform-ls@claude-code-lsps" (or (has "terraform" .tools.brew) (has "terraform" .tools.mise))
    "tofu-ls@claude-code-lsps" (or (has "opentofu" .tools.brew) (has "opentofu" .tools.mise))
    "typescript-language-server@claude-code-lsps" (or (has "typescript" .tools.brew) (has "typescript" .tools.mise) (has "typescript" .tools.node)) }}

{{- if has "claude" .ai.agents }}

{{ includeTemplate "agent-plugins.tmpl" (dict
  "command" "claude"
  "command_add" "install"
  "command_list" "claude plugin list --json | jq -r '.[].id'"
  "command_remove" "uninstall"
  "command_update" "update"
  "lsps" $lsps
  "plugins" $plugins) }}
{{- end }}

{{- if has "codex" .ai.agents }}

{{ includeTemplate "agent-plugins.tmpl" (dict
  "command" "codex"
  "command_add" "add"
  "command_list" "codex plugin list --json | jq -r '.installed[].pluginId'"
  "command_remove" "remove"
  "command_update" "upgrade"
  "lsps" dict
  "plugins" $plugins) }}
{{- end }}

{{- if has "copilot" .ai.agents }}

{{ includeTemplate "agent-plugins.tmpl" (dict
  "command" "copilot"
  "command_add" "install"
  "command_list" "copilot plugin list | grep -oE '[A-Za-z0-9._-]+@[A-Za-z0-9._-]+'"
  "command_remove" "uninstall"
  "command_update" "update"
  "lsps" dict
  "plugins" $plugins) }}
{{- end }}
