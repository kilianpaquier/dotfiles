#!/bin/sh

set -e

{{- $mempalace := or (has "mempalace" .tools.mise) (has "mempalace" .tools.uv) }}
{{- $context7 := or (has "context7" .tools.mise) (has "context7" .tools.node) }}
{{- $caveman := has "caveman" .ai.plugins }}
{{- $ponytail := has "ponytail" .ai.plugins }}

{{- $go := or (has "go" .tools.brew) (has "go" .tools.mise) }}
{{- $java := or (has "java" .tools.brew) (has "java" .tools.mise) }}
{{- $kotlin := or (has "kotlin" .tools.brew) (has "kotlin" .tools.mise) }}
{{- $opentofu := or (has "opentofu" .tools.brew) (has "opentofu" .tools.mise) }}
{{- $shell := or (has "shell" .tools.brew) (has "shell" .tools.mise) (has "shell" .tools.node) }}
{{- $terraform := or (has "terraform" .tools.brew) (has "terraform" .tools.mise) }}
{{- $typescript := or (has "typescript" .tools.brew) (has "typescript" .tools.mise) (has "typescript" .tools.node) }}

{{- if has "claude" .ai.agents }}

claude plugin marketplace add mempalace/mempalace
claude plugin {{ $mempalace | ternary "install" "uninstall" }} mempalace@mempalace || true

claude plugin marketplace add DietrichGebert/ponytail
claude plugin {{ $ponytail | ternary "install" "uninstall" }} ponytail@ponytail || true

claude plugin marketplace add kilianpaquier/ai-integration
claude plugin {{ has "codebase-memory-mcp" .tools.mise | ternary "install" "uninstall" }} codebase-memory-mcp@one-for-all || true
claude plugin {{ has "codegraph" .tools.mise | ternary "install" "uninstall" }} codegraph@one-for-all || true
claude plugin {{ $context7 | ternary "install" "uninstall" }} context7@one-for-all || true
claude plugin install protected-paths@one-for-all
claude plugin install schema-converter@one-for-all

claude plugin marketplace add piebald-ai/claude-code-lsps
claude plugin {{ $shell | ternary "install" "uninstall" }} bash-language-server@claude-code-lsps || true
claude plugin {{ $go | ternary "install" "uninstall" }} gopls@claude-code-lsps || true
claude plugin {{ $java | ternary "install" "uninstall" }} jdtls@claude-code-lsps || true
claude plugin {{ $kotlin | ternary "install" "uninstall" }} kotlin-lsp@claude-code-lsps || true
claude plugin {{ $terraform | ternary "install" "uninstall" }} terraform-ls@claude-code-lsps || true
claude plugin {{ $opentofu | ternary "install" "uninstall" }} tofu-ls@claude-code-lsps || true
claude plugin {{ $typescript | ternary "install" "uninstall" }} typescript-language-server@claude-code-lsps || true
{{- else }}

rm -rf "$HOME/.claude"
{{- end }}

{{- if has "codex" .ai.agents }}

codex plugin marketplace add mempalace/mempalace
codex plugin {{ $mempalace | ternary "add" "remove" }} mempalace@mempalace || true

codex plugin marketplace add DietrichGebert/ponytail
codex plugin {{ $ponytail | ternary "add" "remove" }} ponytail@ponytail || true

codex plugin marketplace add kilianpaquier/ai-integration
codex plugin {{ has "codebase-memory-mcp" .tools.mise | ternary "add" "remove" }} codebase-memory-mcp@one-for-all || true
codex plugin {{ has "codegraph" .tools.mise | ternary "add" "remove" }} codegraph@one-for-all || true
codex plugin {{ $context7 | ternary "add" "remove" }} context7@one-for-all || true
codex plugin add protected-paths@one-for-all
codex plugin add schema-converter@one-for-all
{{- else }}

rm -rf "$HOME/.codex"
{{- end }}

{{- if has "copilot" .ai.agents }}

copilot plugin marketplace add mempalace/mempalace || true
copilot plugin {{ $mempalace | ternary "install" "uninstall" }} mempalace@mempalace || true

copilot plugin marketplace add DietrichGebert/ponytail || true
copilot plugin {{ $ponytail | ternary "install" "uninstall" }} ponytail@ponytail || true

copilot plugin marketplace add kilianpaquier/ai-integration || true
copilot plugin {{ has "codebase-memory-mcp" .tools.mise | ternary "install" "uninstall" }} codebase-memory-mcp@one-for-all || true
copilot plugin {{ has "codegraph" .tools.mise | ternary "install" "uninstall" }} codegraph@one-for-all || true
copilot plugin {{ $context7 | ternary "install" "uninstall" }} context7@one-for-all || true
copilot plugin install protected-paths@one-for-all
copilot plugin install schema-converter@one-for-all
{{- else }}

rm -rf "$HOME/.copilot"
{{- end }}
