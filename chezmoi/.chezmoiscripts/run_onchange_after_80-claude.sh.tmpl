#!/bin/sh

set -e

if ! command -v claude >/dev/null 2>&1; then
  exit 0
fi

installed_marketplaces=$(claude plugin marketplace list)
installed_plugins=$(claude plugin list)

if ! echo "$installed_marketplaces" | grep -q anthropics/claude-plugins-official; then
  claude plugin marketplace add anthropics/claude-plugins-official
fi
claude plugin marketplace update

for plugin in claude-code-setup claude-md-management gopls-lsp; do
  if echo "$installed_plugins" | grep -q $plugin@claude-plugins-official; then
    claude plugin update $plugin@claude-plugins-official
  else
    claude plugin install $plugin@claude-plugins-official
  fi
done

{{- if eq .profile "home" }}

for plugin in context7 github gitlab; do
  if echo "$installed_plugins" | grep -q $plugin@claude-plugins-official; then
    claude plugin update $plugin@claude-plugins-official
  else
    claude plugin install $plugin@claude-plugins-official
  fi
done
{{- end }}
