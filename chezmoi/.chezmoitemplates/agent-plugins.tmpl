{{- /* shared plugin wiring for every agent runtime, they differ only by binary name, verbs and install listing */ -}}

{{- $enable := list -}}
{{- $disable := list -}}

{{- range $id, $enabled := merge (dict) .plugins .lsps -}}
  {{- if $enabled }}{{ $enable = append $enable $id }}{{ else }}{{ $disable = append $disable $id }}{{ end -}}
{{- end -}}

{{ .command }} plugin marketplace add DietrichGebert/ponytail || true
{{ .command }} plugin marketplace add kilianpaquier/ai-integration || true
{{ .command }} plugin marketplace add mempalace/mempalace || true
{{- if .lsps }}
{{ .command }} plugin marketplace add piebald-ai/claude-code-lsps || true
{{- end }}
{{ .command }} plugin marketplace {{ .command_update }} || true

installed=" $({{ .command_list }} | tr '\n' ' ')"

{{ if $enable }}

for plugin in {{ $enable | join " " }}; do
  case "$installed" in *" $plugin "*) continue ;; esac
  {{ .command }} plugin {{ .command_add }} "$plugin" || true
done
{{ end }}

{{- if $disable }}

for plugin in {{ $disable | join " " }}; do
  case "$installed" in *" $plugin "*) {{ .command }} plugin {{ .command_remove }} "$plugin" || true ;; esac
done
{{ end -}}
