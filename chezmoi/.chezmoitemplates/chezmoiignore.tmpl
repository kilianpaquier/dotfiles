{{- end }}

{{- if or (eq (len .container.runtimes) 0) (not (has "gitlab-ci-local" .tools.mise)) }}
.gitlab-ci-local
{{- end }}

{{- if eq .machine.kind "desktop" }}
.config/git/config
.config/git/ignore
.config/gopass
{{- end }}

{{- if not .git.ssh }}
.config/git/ssh-sign.sh
{{- end }}

{{- if not (or (has "opentofu" .tools.mise) (has "terraform" .tools.mise)) }}
.terraformrc
{{- end }}

{{- if eq (len .container.runtimes) 0 }}
.docker
{{- end }}

{{- if not (has "podman" .container.runtimes) }}
.config/containers
{{- end }}

{{- if not (has "agentsview" .tools.mise) }}
.agentsview
{{- end }}

{{- if or (eq (len .ai.runtimes) 0) (not (has "codegraph" .tools.mise)) }}
.codegraph
{{- end }}

{{- if or (eq (len .ai.runtimes) 0) (not (has "destructive-command-guard" .tools.mise)) }}
.config/dcg
{{- end }}

{{- if or (eq (len .ai.runtimes) 0) (not (has "rtk" .tools.mise)) }}
.config/rtk
{{- end }}

{{- if eq (len .ai.runtimes) 0 }}
.apm
.config/protected-paths
{{- end }}

{{- if not (has "claude" .ai.runtimes) }}
.claude
{{- end }}

{{- if not (has "codex" .ai.runtimes) }}
.codex
{{- end }}

{{- if not (has "copilot" .ai.runtimes) }}
.copilot
{{- end }}

{{- range $agent := list "claude" "codex" "copilot" }}
{{- if not (has $agent $.ai.runtimes) }}
.sbx/kits/{{ $agent }}.yaml
