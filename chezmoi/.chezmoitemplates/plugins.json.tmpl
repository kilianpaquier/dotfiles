{{- $plugins := dict
    "caveman@one-for-all" (has "caveman" .ai.plugins)
    "code-simplifier@one-for-all" true
    "codegraph@one-for-all" (has "codegraph" .tools.mise)
    "context7@one-for-all" (has "context7" .tools.mise)
    "dcg@one-for-all" (has "destructive-command-guard" .tools.mise)
    "exam-drill@one-for-all" true
    "feature-dev@one-for-all" true
    "mempalace@mempalace" (has "mempalace" .tools.mise)
    "ponytail@ponytail" (has "ponytail" .ai.plugins)
    "protected-paths@one-for-all" true
    "schema-converter@one-for-all" true }}
{{- if .lsps }}
  {{- $plugins = merge $plugins (dict
    "bash-language-server@claude-code-lsps" (has "shell" .tools.mise)
    "gopls@claude-code-lsps" (has "go" .tools.mise)
    "jdtls@claude-code-lsps" (has "java" .tools.mise)
    "kotlin-lsp@claude-code-lsps" (has "kotlin" .tools.mise)
    "terraform-ls@claude-code-lsps" (has "terraform" .tools.mise)
    "tofu-ls@claude-code-lsps" (has "opentofu" .tools.mise)) }}
{{- end }}
{{- $plugins | toJson }}
