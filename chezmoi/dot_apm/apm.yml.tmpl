# yaml-language-server: $schema=https://microsoft.github.io/apm/specs/schemas/manifest-v0.1.schema.json

name: {{ .user.username }}
version: 1.0.0

author: {{ .user.username }}
description: APM project for {{ .user.username }}

dependencies:
  apm:
    - mattpocock/skills/skills/engineering/diagnosing-bugs
    - mattpocock/skills/skills/productivity/grill-me
    - mattpocock/skills/skills/productivity/grilling
    - mattpocock/skills/skills/productivity/writing-for-agents
    - vercel-labs/skills/skills/find-skills
  mcp: []

includes: auto
targets:
{{- /* APM has no pi target before 0.39, and pi reads the agent-skills target's ~/.agents/skills. */}}
{{- range .ai.runtimes }}
  - {{ eq . "pi" | ternary "agent-skills" . }}
{{- end }}
