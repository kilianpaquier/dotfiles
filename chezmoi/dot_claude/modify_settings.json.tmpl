#!/bin/sh

set -e

# shallow merge (+ not *) so an object defined in the partial fully replaces the local one instead of merging keys into it
jq -s --indent 2 --argjson plugins '{{ includeTemplate "claude-plugins.json.tmpl" . }}' '(.[0] // {}) + (.[1] // {}) + $plugins' - "$CHEZMOI_SOURCE_DIR/dot_claude/settings.partial.json"
