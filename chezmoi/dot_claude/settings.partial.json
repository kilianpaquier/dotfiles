{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "alwaysThinkingEnabled": true,
    "attribution": {
        "commit": "Co-Authored-By: Claude <noreply@anthropic.com>",
        "pr": "🤖 Generated with Claude Code"
    },
    "autoCompactEnabled": false,
    "autoCompactWindow": 180000,
    "autoMemoryEnabled": false,
    "autoUploadSessions": false,
    "cleanupPeriodDays": 60,
    "defaultView": "chat",
    "effortLevel": "medium",
    "extraKnownMarketplaces": {
        "claude-code-lsps": {
            "source": {
                "repo": "piebald-ai/claude-code-lsps",
                "source": "github"
            }
        },
        "claude-plugins-official": {
            "source": {
                "repo": "anthropics/claude-plugins-official",
                "source": "github"
            }
        },
        "mempalace": {
            "source": {
                "repo": "mempalace/mempalace",
                "source": "github"
            }
        },
        "one-for-all": {
            "source": {
                "repo": "kilianpaquier/ai-integration",
                "source": "github"
            }
        },
        "ponytail": {
            "source": {
                "repo": "DietrichGebert/ponytail",
                "source": "github"
            }
        }
    },
    "fileCheckpointingEnabled": true,
    "inputNeededNotifEnabled": true,
    "modelSettings": {
        "claude-opus-5": {
            "effortLevel": "high"
        },
        "claude-sonnet-5": {
            "effortLevel": "medium"
        }
    },
    "permissions": {
        "additionalDirectories": [
            "~/.local/share/chezmoi",
            "~/workspaces"
        ],
        "allow": [
            "Agent",
            "Bash",
            "Edit(./**)",
            "mcp__codegraph",
            "mcp__context7",
            "mcp__github",
            "mcp__gitlab",
            "mcp__mempalace",
            "mcp__opentofu",
            "mcp__plugin_codegraph_codegraph",
            "mcp__plugin_context7_context7",
            "mcp__plugin_github_github",
            "mcp__plugin_gitlab_gitlab",
            "mcp__plugin_mempalace_mempalace",
            "mcp__plugin_opentofu_opentofu",
            "Read(~/.local/share/chezmoi/**)",
            "Read(~/workspaces/**)",
            "Skill",
            "WebSearch"
        ],
        "ask": [
            "mcp__github__add_comment_to_pending_review",
            "mcp__github__add_issue_comment",
            "mcp__github__add_reply_to_pull_request_comment",
            "mcp__github__create_branch",
            "mcp__github__create_or_update_file",
            "mcp__github__create_pull_request",
            "mcp__github__create_repository",
            "mcp__github__delete_file",
            "mcp__github__fork_repository",
            "mcp__github__issue_write",
            "mcp__github__merge_pull_request",
            "mcp__github__pull_request_review_write",
            "mcp__github__push_files",
            "mcp__github__request_copilot_review",
            "mcp__github__run_secret_scanning",
            "mcp__github__sub_issue_write",
            "mcp__github__update_pull_request_branch",
            "mcp__github__update_pull_request",
            "mcp__gitlab__attach_scan_profile",
            "mcp__gitlab__create_issue",
            "mcp__gitlab__create_merge_request_note",
            "mcp__gitlab__create_merge_request",
            "mcp__gitlab__create_workitem_note",
            "mcp__gitlab__link_work_items",
            "mcp__gitlab__manage_pipeline",
            "mcp__mempalace__mempalace_delete_by_source",
            "mcp__mempalace__mempalace_delete_drawer",
            "mcp__mempalace__mempalace_delete_hallway",
            "mcp__mempalace__mempalace_delete_tunnel",
            "mcp__mempalace__mempalace_kg_invalidate",
            "mcp__plugin_github_github__add_comment_to_pending_review",
            "mcp__plugin_github_github__add_issue_comment",
            "mcp__plugin_github_github__add_reply_to_pull_request_comment",
            "mcp__plugin_github_github__create_branch",
            "mcp__plugin_github_github__create_or_update_file",
            "mcp__plugin_github_github__create_pull_request",
            "mcp__plugin_github_github__create_repository",
            "mcp__plugin_github_github__delete_file",
            "mcp__plugin_github_github__fork_repository",
            "mcp__plugin_github_github__issue_write",
            "mcp__plugin_github_github__merge_pull_request",
            "mcp__plugin_github_github__pull_request_review_write",
            "mcp__plugin_github_github__push_files",
            "mcp__plugin_github_github__request_copilot_review",
            "mcp__plugin_github_github__run_secret_scanning",
            "mcp__plugin_github_github__sub_issue_write",
            "mcp__plugin_github_github__update_pull_request_branch",
            "mcp__plugin_github_github__update_pull_request",
            "mcp__plugin_gitlab_gitlab__attach_scan_profile",
            "mcp__plugin_gitlab_gitlab__create_issue",
            "mcp__plugin_gitlab_gitlab__create_merge_request_note",
            "mcp__plugin_gitlab_gitlab__create_merge_request",
            "mcp__plugin_gitlab_gitlab__create_workitem_note",
            "mcp__plugin_gitlab_gitlab__link_work_items",
            "mcp__plugin_gitlab_gitlab__manage_pipeline",
            "mcp__plugin_mempalace_mempalace__mempalace_delete_by_source",
            "mcp__plugin_mempalace_mempalace__mempalace_delete_drawer",
            "mcp__plugin_mempalace_mempalace__mempalace_delete_hallway",
            "mcp__plugin_mempalace_mempalace__mempalace_delete_tunnel",
            "mcp__plugin_mempalace_mempalace__mempalace_kg_invalidate"
        ],
        "defaultMode": "default",
        "deny": [
            "WebFetch"
        ],
        "disableBypassPermissionsMode": "disable"
    },
    "preferredNotifChannel": "auto",
    "remoteControlAtStartup": false,
    "respectGitignore": true,
    "sandbox": {
        "allowUnsandboxedCommands": false,
        "autoAllowBashIfSandboxed": true,
        "enabled": false,
        "failIfUnavailable": true
    },
    "showMessageTimestamps": true,
    "showTurnDuration": true,
    "syntaxHighlightingDisabled": false,
    "theme": "dark-ansi",
    "todoFeatureEnabled": true,
    "tui": "fullscreen",
    "useAutoModeDuringPlan": false,
    "verbose": false,
    "viewMode": "focus",
    "worktree": {
        "baseRef": "head",
        "bgIsolation": "worktree"
    }
}
