{{- if .user.username }}
[user]
	name = {{ .user.username }}
	email = {{ .user.email }}
{{- if .git.ssh }}
	signingKey = ~/.ssh/id_ed25519
{{- end }}
{{- end }}
{{- if has "vscode" .ide }}
[core]
	editor = code --wait
{{- end }}
[init]
	defaultbranch = main
[push]
	autoSetupRemote = true
{{- if .git.ssh }}
[commit]
	gpgsign = true
[gpg]
	format = ssh
[gpg "ssh"]
	defaultKeyCommand = ssh-add -L
	program = ~/.config/git/ssh-sign.sh
[tag]
	gpgsign = true
{{- end }}
{{- if eq .user.username "kilianpaquier" }}
[alias]
	alias = !git config --get-regexp ^alias\\. | sed -e s/^alias\\.// -e s/\\ /\\ =\\ /
	amend = commit --amend --no-edit
	branches = branch --format='%(HEAD) %(color:yellow)%(refname:short)%(color:reset) - %(contents:subject) %(color:green)(%(committerdate:relative)) [%(authorname)]' --sort=-committerdate
	c = commit -m
	cp = cherry-pick
	current = branch --show-current
	upstream = "!f() { git branch --set-upstream-to=\"${1-origin}/$(git current)\" \"$(git current)\"; }; f"
	ls = log --stat
	last = ls -1 HEAD --stat
	ll = ls --oneline
	mad = reset --hard
	n = checkout -b
	p = push
	pf = push --force-with-lease
	purge = "!git fetch -p && for branch in $(git for-each-ref --format '%(refname) %(upstream:track)' refs/heads | awk '$2 == \"[gone]\" {sub(\"refs/heads/\", \"\", $1); print $1}'); do git branch -D $branch; done"
	r = !git fetch --all && git rebase
	rename = commit --amend
	search = !git rev-list --all | xargs git grep -F
	undo = reset HEAD~1 --mixed
	unstage = reset HEAD --
{{- end }}
