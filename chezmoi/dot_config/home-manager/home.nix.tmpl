{ config, pkgs, ... }:

{{- $packages := list .shell "bash-completion" "file" "gcc" "gcc.cc.lib" "gettext" "git" "git-credential-gopass" "gnumake" "gnupg" "gopass" "jq" "pinentry-curses" "python3" "ripgrep" "socat" "tree" "unzip" "vim" "xdg-utils" }}

{{- if has "mise" .tools_management }}{{- $packages = append $packages "mise" }}{{- end }}

{{- if gt (len .ai.runtimes) 0 }}{{- $packages = append $packages "apm-cli" }}{{- end }}
{{- if has "claude" .ai.runtimes }}{{- $packages = concat $packages (list "bubblewrap" "claude-code") }}{{- end }}
{{- if has "codex" .ai.runtimes }}{{- $packages = append $packages "codex" }}{{- end }}
{{- if has "copilot" .ai.runtimes }}{{- $packages = append $packages "github-copilot-cli" }}{{- end }}

{{- if has "docker" .container.runtimes }}{{- $packages = concat $packages (list "docker" "passt") }}{{- end }}
{{- if has "podman" .container.runtimes }}{{- $packages = concat $packages (list "podman" "podman-compose" "docker-compose") }}{{- end }}

{{- if eq .machine.kind "desktop" }}
  {{- $packages = concat $packages (list "libreoffice" "spotify") }}
  {{- if has "vscode" .ide }}{{- $packages = append $packages "vscode" }}{{- end }}
  {{- if has "zed" .ide }}{{- $packages = append $packages "zed-editor" }}{{- end }}
  {{- if eq .profile "home" }}{{- $packages = concat $packages (list "brave" "discord" "netbird-ui" "nextcloud-client" "yubioath-flutter") }}{{- end }}
{{- end }}

{
  # user extension point, a symlink into the dotfiles repo
  imports = [ ./local.nix ];

  home.username = "{{ .chezmoi.username }}";
  home.homeDirectory = "{{ .chezmoi.homeDir }}";

  # home-manager state version, all updates must be done carefully to avoid breakage
  home.stateVersion = "26.05";

  # packages to install
  home.packages = with pkgs; [
{{- range $packages | sortAlpha }}
    {{ . }}
{{- end }}
  ];

{{- if or (eq .machine.kind "desktop") (has "claude" .ai.runtimes) (has "copilot" .ai.runtimes) }}

  # proprietary packages (claude-code, discord, github-copilot-cli, spotify, vscode) are refused by nixpkgs unless unfree is allowed.
  nixpkgs.config.allowUnfree = true;
{{- end }}

{{- if gt (len .ai.runtimes) 0 }}

  # apm-cli pins websockets<17 while nixpkgs ships 17, drop once nixpkgs relaxes it.
  nixpkgs.overlays = [
    (final: prev: {
      apm-cli = prev.apm-cli.overridePythonAttrs (old: {
        pythonRelaxDeps = (old.pythonRelaxDeps or [ ]) ++ [ "websockets" ];
      });
    })
  ];
{{- end }}

{{- if has "docker" .container.runtimes }}

  systemd.user.services.docker = {
    Install.WantedBy = [ "default.target" ];
    Service = {
      # the user manager PATH has newuidmap but not the nix profile, pasta lives there
      Environment = [
        "DOCKERD_ROOTLESS_ROOTLESSKIT_NET=pasta"
        "DOCKERD_ROOTLESS_ROOTLESSKIT_PORT_DRIVER=implicit"
        "PATH=%h/.nix-profile/bin:/usr/bin:/bin"
      ];
      ExecStart = "${pkgs.docker}/bin/dockerd-rootless";
    };
  };
{{- end }}

  systemd.user.services.gopass-age-agent = {
    Install.WantedBy = [ "default.target" ];
    Service = {
      Environment = [
        "GOPASS_CONFIG_COUNT=1"
        "GOPASS_CONFIG_KEY_0=age.agent-timeout"
        "GOPASS_CONFIG_VALUE_0=3600"
        "GOPASS_UMASK=077"
      ];
      ExecStart = "${pkgs.gopass}/bin/gopass age agent start";
    };
  };

  systemd.user.services.gopass-secret-service = {
    Install.WantedBy = [ "default.target" ];
    Unit = {
      After = [ "gopass-age-agent.service" ];
      Requires = [ "gopass-age-agent.service" ];
    };
    Service = {
      # no TTY here, a locked agent must fail on empty stdin instead of spawning the gpg-agent.conf pinentry
      Environment = [
        "GIT_CONFIG_COUNT=1"
        "GIT_CONFIG_KEY_0=commit.gpgsign"
        "GIT_CONFIG_VALUE_0=false"
        "GOPASS_AGE_STDIN_PASSPHRASE=true"
        "GOPASS_UMASK=077"
      ];
      ExecStart = "${pkgs.gopass}/bin/gopass secret-service serve";
      Restart = "on-failure";
      RestartSec = 30;
    };
  };

  # dotfiles management
  home.file = {
    # all dotfiles are managed by chezmoi for easier combination and drift review
  };

  # disable news on switch (spams logs for nothing)
  news.display = "silent";

  # home-manager auto install and self management
  programs.home-manager.enable = true;
}
