{{- $bundles := dict
    "boost" (dict "jfrog-boost" "latest")
    "bun" (dict "bun" "latest")
    "codegraph" (dict "codegraph" "latest")
    "context7" (dict "context7" "latest" "context7-mcp" "latest")
    "gh" (dict "gh" "latest")
    "gitlab-ci-local" (dict "gitlab-ci-local" "latest")
    "glab" (dict "glab" "latest")
    "go" (dict "go" "latest" "golangci-lint" "latest")
    "hugo" (dict "dart-sass" "latest" "hugo-extended" "latest")
    "incus" (dict "incus" "latest")
    "java" (dict "java" "lts" "jdtls" "0.0.0")
    "just" (dict "just" "latest")
    "k8s" (dict "helm" "latest" "helm-ct" "latest" "krew" "latest" "kubectl" "latest" "kustomize" "latest")
    "kotlin" (dict "kotlin" "latest" "kotlin-lsp" "latest")
    "mempalace" (dict "mempalace" "latest")
    "opentofu" (dict "opentofu" "latest" "tofu-ls" "latest" "tflint" "latest")
    "pre-commit" (dict "pre-commit" "latest")
    "pulumi" (dict "pulumi" "latest")
    "rtk" (dict "rtk" "latest")
    "shell" (dict "bash-language-server" "latest" "shellcheck" "latest")
    "terraform" (dict "terraform" "latest" "terraform-ls" "latest" "tflint" "latest")
    "uv" (dict "uv" "latest") }}

{{- $tools := dict "age" "latest" "cosign" "latest" "node" "24" "sops" "latest" "usage" "latest" }}

{{- range $bundle, $specs := $bundles }}
{{- if has $bundle $.tools.mise }}{{ $_ := mergeOverwrite $tools $specs }}{{- end }}
{{- end }}

{{- /* a tool shared by two bundles stays as long as one of them is selected */ -}}
{{- $unset := list }}
{{- range $bundle, $specs := $bundles }}
{{- range $id, $_ := $specs }}
{{- if not (hasKey $tools $id) }}{{ $unset = append $unset (list "tools" $id) }}{{- end }}
{{- end }}
{{- end }}

{{- includeTemplate "scripts/toml-merge.py" (dict "set" (dict "tools" $tools) "sort" (list (list "tools")) "unset" $unset) -}}
