#!/bin/sh

{{- $dirs := list
    (joinPath .chezmoi.homeDir ".local" "share" "chezmoi")
    (joinPath .chezmoi.homeDir "workspaces") }}

# config.json is app-managed state fronted by // comment lines jq cannot parse, so keep them aside and set only trustedFolders
input=$(cat)

printf '%s\n' "$input" | awk '/^\/\// { print; next } { exit }'
printf '%s\n' "$input" | awk 'body || !/^\/\// { body = 1; print }' |
    jq -s --indent 2 --argjson dirs '{{ toJson $dirs }}' '(.[0] // {}) | .trustedFolders = ((.trustedFolders // []) + $dirs | unique)'
