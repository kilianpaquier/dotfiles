# syntax=docker/sandbox-kit:3
# yaml-language-server: $schema=https://raw.githubusercontent.com/docker/sandbox-kit-spec/main/schema/kit.schema.json
# Code generated by AI (Claude Code)

schemaVersion: "3"
kind: set
displayName: tools
description: mise with the host's tools and CA certificates from ~/.sbxenv.yaml mounts, glab, and the network rules of the host sandboxes
version: 0.0.0
licenses: [MIT]

capabilities:
  - group:
      name: ca-certificates
      capabilities:
        - type: com.docker.sandbox/lifecycle@1
          config:
            install:
              # ~/.sbxenv.yaml mounts the host CA certificates under /usr/local/share/ca-certificates/host.
              - command: update-ca-certificates
                description: Trust the host CA certificates, for TLS-inspecting proxies

  - group:
      name: network
      capabilities:
        - type: com.docker.sandbox/network-policy@2
          description: Hosts reached without asking, and the SSH hosts and ports never reached
          config:
            runtime:
              allow: {{ .sandbox.network.allow | sortAlpha | toYaml | trim | nindent 16 }}
              deny: {{ .sandbox.network.deny | sortAlpha | toYaml | trim | nindent 16 }}
{{- if .git.ssh }}

  - group:
      name: ssh-signing
      capabilities:
        - type: com.docker.sandbox/ssh-agent@1
          description: The host ssh-agent signs git commits only, it never logs in to a server
          config:
            phase: runtime
            unrestricted: false
            sign: [git]
{{- end }}

  - group:
      name: mise
      capabilities:
        - type: com.docker.sandbox/host-mount@1
          description: mise tools, installed once and shared by every sandbox of this kit
          config:
            path: /home/agent/.local/share/mise
        - type: com.docker.sandbox/lifecycle@1
          config:
            install:
              # Do not use docker.io/sbx/mise, since it pins mise 2026.5.2.
              - command: curl -fsSL https://mise.run | sh
                user: "1000"
                env: [HTTP_PROXY, HTTPS_PROXY, NO_PROXY]
                description: Install mise into ~/.local/bin
              # Same two lines as symlinks/.profile: shims on PATH, then mise env without its PATH.
              - command:
                  - sh
                  - -c
                  - printf '%s\n' 'export PATH="$HOME/.local/share/mise/shims:$PATH"' 'eval "$(mise env | grep -v PATH=)"' >> "$BASH_ENV"
                user: "1000"
                env: [BASH_ENV]
                description: Load mise shims and env in the agent, which sbx starts through BASH_ENV
            startup:
              - command: /home/agent/.local/bin/mise install -y
                user: "1000"
                background: true
                env: [HTTP_PROXY, HTTPS_PROXY, NO_PROXY]
                description: Install missing tools into the shared directory, a no-op once installed
            files:
              - path: /home/agent/.config/mise/conf.d/20-sbx.toml
                content: |
                  [settings]
                  disable_tools = ["agentsview", "gh", "glab", "mempalace"]

kits:
  - ref: docker.io/sbx/gitlab:1.118.0
