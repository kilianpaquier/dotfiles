schemaVersion: "1"

args:
  agent:
    default: {{ first .ai.runtimes }}
    enum: {{ .ai.runtimes | toJson }}
    description: agent to run

# force shell since agent comes from local installation and avoid harness mount read filesystem issues
agent: shell

workspace: {{ "${{ env.projectDir }}" }}

entrypoint:
  - {{ "${{ env.args.agent }}" }}

env:
  HOME: {{ .chezmoi.homeDir }}

additionalWorkspaces:
{{- if stat "/usr/local/share/ca-certificates" }}
  - { path: /usr/local/share/ca-certificates, target: /usr/local/share/ca-certificates/host, readOnly: true }
{{- end }}

  # Read only paths
{{- range $path := concat .sandbox.full.allow_read | sortAlpha }}
  - { path: {{ replace "~" $.chezmoi.homeDir $path }}, target: {{ replace "~" $.chezmoi.homeDir $path }}, readOnly: true }
{{- end }}

  # Write paths
{{- range $path := concat .sandbox.full.allow_write | sortAlpha }}
  - { path: {{ replace "~" $.chezmoi.homeDir $path }}, target: {{ replace "~" $.chezmoi.homeDir $path }} }
{{- end }}

sandboxOptions:
  # The host skills directories are mounted instead of sbx's copied store.
  skills: "off"
