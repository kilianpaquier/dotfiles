# Code generated by AI (Claude Code)

schemaVersion: "1"

agent: {{ "${{ env.args.agent }}" }}
args:
  agent:
    default: {{ first .ai.runtimes }}
    enum: {{ .ai.runtimes | toJson }}
    description: agent to run

workspace: {{ "${{ env.projectDir }}" }}

kits:
  - {{ .chezmoi.homeDir }}/.sbx/kits/{{ "${{ env.args.agent }}" }}
  - {{ .chezmoi.homeDir }}/.sbx/kits/tools

# Read-only, never a credential file (.claude/.credentials.json, .codex/auth.json, .copilot/config.json, mise config.secrets.toml).
additionalWorkspaces:
{{- if stat "/usr/local/share/ca-certificates" }}
  - { path: /usr/local/share/ca-certificates, target: /usr/local/share/ca-certificates/host, readOnly: true }
{{- end }}

{{- range $agent := .ai.runtimes }}
{{- with index $.sandbox.agents $agent }}
{{- range $path := concat .read .read_files }}
  - { path: {{ $.chezmoi.homeDir }}{{ trimPrefix "~" $path }}, target: /home/agent{{ trimPrefix "~" $path }}, readOnly: true }
{{- end }}
{{- end }}
{{- end }}

sandboxOptions:
  # The host skills directories are mounted instead of sbx's copied store.
  skills: "off"
