{{/* chezmoi:template:missing-key=zero */}}
{{- $allow_write := concat .sandbox.write (list (print "/tmp/claude-" .chezmoi.uid) (print "/tmp/cc-daemon-" .chezmoi.uid)) }}
{{- $deny_domain := .sandbox.network.deny_domain }}

{{- $deny_reason := dict }}
{{- range .sandbox.network.deny_port }}
{{- $deny_domain = append $deny_domain (printf "*:%v" .) }}
{{- $_ := set $deny_reason (printf "*:%v" .) "Port blocked, related actions must be made on the host by the user" }}
{{- end }}

{{- $local := dict }}
{{- $file := joinPath .chezmoi.homeDir ".config/chezmoi/sandbox.local.yaml" }}
{{- if stat $file }}{{ $local = include $file | fromYaml }}{{- end }}

{{- $local_credentials := $local.credentials | default dict }}
{{- $names := concat (keys .sandbox.credentials) (keys $local_credentials) | uniq | sortAlpha }}

{{- $domains := concat .sandbox.network.fetch_domain .sandbox.network.auth_domain .sandbox.network.dl_domain
      ($local.fetch_domain | default list) ($local.auth_domain | default list) ($local.dl_domain | default list) -}}

{
    "credentials": {
        "envVars": [
{{- range $i, $name := $names }}
  {{- $base := get $.sandbox.credentials $name | default dict }}
  {{- $extra := get $local_credentials $name | default dict }}
  {{- $extract := $extra.extract | default $base.extract }}
  {{- $hosts := concat ($base.hosts | default list) ($extra.hosts | default list) | uniq | sortAlpha }}
  {{- $domains = concat $domains $hosts }}
  {{- if $i }},{{ end }}
            {
                "name": {{ $name | quote }},
                "mode": "mask",
{{- if $extract }}
                "extract": {{ $extract | toJson }},
                "onExtractNoMatch": "deny",
{{- end }}
                "injectHosts": {{ $hosts | toJson }}
            }
{{- end }}
        ]
    },
    "filesystem": {
        "allowRead": {{ concat .sandbox.read .sandbox.read_host .sandbox.read_local | sortAlpha | toPrettyJson "    " | indent 8 | trim }},
        "allowWrite": {{ $allow_write | sortAlpha | toPrettyJson "    " | indent 8 | trim }},
        "denyRead": {{ .sandbox.deny_read | sortAlpha | toPrettyJson "    " | indent 8 | trim }},
        "denyWrite": {{ .sandbox.deny_write | sortAlpha | toPrettyJson "    " | indent 8 | trim }}
    },
    "mandatoryDenySearchDepth": 6,
    "network": {
        "allowAllUnixSockets": true,
        "allowedDomains": {{ $domains | uniq | sortAlpha | toPrettyJson "    " | indent 8 | trim }},
        "deniedDomainReasons": {{ $deny_reason | toPrettyJson "    " | indent 8 | trim }},
        "deniedDomains": {{ $deny_domain | sortAlpha | toPrettyJson "    " | indent 8 | trim }},
        "tlsTerminate": {}
    }
}
