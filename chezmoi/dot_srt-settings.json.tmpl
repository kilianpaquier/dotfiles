{{- $allow_write := append .sandbox.write (print "/tmp/claude-" .chezmoi.uid) }}
{{- $deny_domain := .sandbox.network.deny_domain }}

{{- $deny_reason := dict }}
{{- range .sandbox.network.deny_port }}
{{- $deny_domain = append $deny_domain (printf "*:%v" .) }}
{{- $_ := set $deny_reason (printf "*:%v" .) "Port blocked, related actions must be made on the host by the user" }}
{{- end -}}

{
    "credentials": {
        "envVars": [
            {
                "name": "ANTHROPIC_API_KEY",
                "mode": "mask",
                "extract": "^(.+)$",
                "onExtractNoMatch": "deny",
                "injectHosts": ["api.anthropic.com"]
            },
            {
                "name": "ANTHROPIC_AUTH_TOKEN",
                "mode": "mask",
                "extract": "^(.+)$",
                "onExtractNoMatch": "deny",
                "injectHosts": ["api.anthropic.com"]
            },
            {
                "name": "CLAUDE_CODE_OAUTH_TOKEN",
                "mode": "mask",
                "extract": "^(.+)$",
                "onExtractNoMatch": "deny",
                "injectHosts": ["api.anthropic.com"]
            },
            {
                "name": "COPILOT_GITHUB_TOKEN",
                "mode": "mask",
                "extract": "^(?:gho_|ghu_|github_pat_)(.+)$",
                "onExtractNoMatch": "deny",
                "injectHosts": [
                    "*.githubcopilot.com",
                    "api.github.com",
                    "githubcopilot.com"
                ]
            },
            {
                "name": "GITHUB_TOKEN",
                "mode": "mask",
                "extract": "^(.+)$",
                "onExtractNoMatch": "deny",
                "injectHosts": [
                  "api.github.com",
                  "uploads.github.com"
                ]
            },
            {
                "name": "GH_TOKEN",
                "mode": "mask",
                "extract": "^(.+)$",
                "onExtractNoMatch": "deny",
                "injectHosts": [
                  "api.github.com",
                  "uploads.github.com"
                ]
            },
            {
                "name": "GITLAB_TOKEN",
                "mode": "mask",
                "extract": "^(.+)$",
                "onExtractNoMatch": "deny",
                "injectHosts": ["gitlab.com"]
            },
            {
                "name": "GL_TOKEN",
                "mode": "mask",
                "extract": "^(.+)$",
                "onExtractNoMatch": "deny",
                "injectHosts": ["gitlab.com"]
            }
        ]
    },
    "filesystem": {
        "allowRead": {{ concat .sandbox.read .sandbox.read_host .sandbox.read_local | sortAlpha | toPrettyJson "    " | indent 8 | trim }},
        "allowWrite": {{ $allow_write | sortAlpha | toPrettyJson "    " | indent 8 | trim }},
        "denyRead": {{ .sandbox.deny_read | sortAlpha | toPrettyJson "    " | indent 8 | trim }},
        "denyWrite": {{ .sandbox.deny_write | sortAlpha | toPrettyJson "    " | indent 8 | trim }}
    },
    "mandatoryDenySearchDepth": 6,
    "network": {
        "allowAllUnixSockets": false,
        "allowedDomains": {{ .sandbox.network.allow_domain | sortAlpha | toPrettyJson "    " | indent 8 | trim }},
        "deniedDomainReasons": {{ $deny_reason | toPrettyJson "    " | indent 8 | trim }},
        "deniedDomains": {{ $deny_domain | sortAlpha | toPrettyJson "    " | indent 8 | trim }},
        "tlsTerminate": {}
    }
}
