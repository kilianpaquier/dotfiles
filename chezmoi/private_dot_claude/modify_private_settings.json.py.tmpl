{{/* chezmoi:template:missing-key=zero */}}
{{- $set := include "private_dot_claude/settings.partial.json" | fromJson }}

{{- /* host-only permission mode, the sbx claude mixin uses the partial as its managed settings */ -}}
{{- $_ := set $set.permissions "defaultMode" "auto" }}
{{- $_ := set $set.permissions "disableBypassPermissionsMode" "disable" }}

{{- $local := dict }}
{{- $file := joinPath .chezmoi.homeDir ".config/chezmoi/sandbox.local.yaml" }}
{{- if stat $file }}{{ $local = include $file | fromYaml }}{{- end }}

{{- $fetch := list }}
{{- range concat .sandbox.network.fetch_domain ($local.fetch_domain | default list) }}{{- $fetch = append $fetch (printf "WebFetch(domain:%s)" .) }}{{- end }}
{{- $_ := set $set.permissions "allow" (concat $set.permissions.allow $fetch) }}

{{- $enabled_plugins := dict }}
{{- $unset := list (list "sandbox") }}

{{- range $id, $on := includeTemplate "plugins.json.tmpl" (merge (dict "lsps" true) .) | fromJson }}
{{- if $on }}{{- $_ := set $enabled_plugins $id true }}{{- else }}{{- $unset = append $unset (list "enabledPlugins" $id) }}{{- end }}
{{- end }}
{{- $_ := set $set "enabledPlugins" $enabled_plugins }}

{{- includeTemplate "scripts/json-merge.py" (dict
  "indent" 2
  "override" (list (list "permissions" "allow") (list "permissions" "deny") (list "permissions" "ask"))
  "set" $set
  "sort" (list
    (list "enabledPlugins")
    (list "permissions" "allow")
    (list "permissions" "deny")
    (list "permissions" "ask"))
  "unset" $unset) }}
