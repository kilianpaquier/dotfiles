{ config, lib, pkgs, ... }:

{{- $packages := list .shell "bash-completion" "file" "gcc" "gcc.cc.lib" "gettext" "git" "gnumake" "gnupg" "jq" "pinentry-curses" "python3" "ripgrep" "rsync" "socat" "tree" "unzip" "vim" "xdg-utils" }}

{{- if gt (len .ai.runtimes) 0 }}{{- $packages = append $packages "apm-cli" }}{{- end }}
{{- if has "claude" .ai.runtimes }}{{- $packages = concat $packages (list "bubblewrap" "claude-code") }}{{- end }}
{{- if has "copilot" .ai.runtimes }}{{- $packages = concat $packages (list "bubblewrap" "github-copilot-cli" "iptables" "slirp4netns") }}{{- end }}

{{- if has "docker" .container.runtimes }}{{- $packages = concat $packages (list "docker" "passt") }}{{- end }}
{{- if has "podman" .container.runtimes }}{{- $packages = concat $packages (list "podman" "podman-compose" "docker-compose") }}{{- end }}
{{- if gt (len .container.runtimes) 0 }}{{- $packages = append $packages "docker-credential-helpers" }}{{- end }}

{{- if eq .machine.kind "desktop" }}
  {{- $packages = concat $packages (list "libreoffice" "spotify") }}
  {{- if has "vscode" .ide }}{{- $packages = append $packages "vscode" }}{{- end }}
  {{- if has "zed" .ide }}{{- $packages = append $packages "zed-editor" }}{{- end }}
  {{- if eq .profile "home" }}{{- $packages = concat $packages (list "brave" "discord" "netbird-ui" "nextcloud-client" "yubioath-flutter") }}{{- end }}
  {{- if eq .profile "soprasteria" }}{{- $packages = append $packages "firefox" }}{{- end }}
{{- else }}
  {{- $packages = concat $packages (list "git-credential-gopass" "gopass") }}
{{- end }}

{
  # user extension point, a symlink into the dotfiles repo
  imports = [ ./home.local.nix ];

  home.username = "{{ .chezmoi.username }}";
  home.homeDirectory = "{{ .chezmoi.homeDir }}";

  # home-manager state version, all updates must be done carefully to avoid breakage
  home.stateVersion = "26.05";

{{- if or (eq .machine.kind "desktop") (has "claude" .ai.runtimes) (has "copilot" .ai.runtimes) }}

  # proprietary packages (claude-code, discord, github-copilot-cli, spotify, vscode) are refused by nixpkgs unless unfree is allowed.
  nixpkgs.config.allowUnfree = true;
{{- end }}

  # packages to install
  home.packages = with pkgs; [
{{- range $packages | uniq | sortAlpha }}
    {{ . }}
{{- end }}
  ];

  services.home-manager.autoUpgrade = {
    enable = true;
    frequency = "daily";
  };

  nix.gc = {
    automatic = true;
    dates = "weekly";
    options = "--delete-older-than 30d";
  };

  # the profile lives in ~/.local/state/nix instead of the ~/.nix-profile symlink
  nix.package = pkgs.nix;
  nix.settings.use-xdg-base-directories = true;

  # one ssh-agent at a fixed socket ($XDG_RUNTIME_DIR/ssh-agent), so the host sandboxes can grant that single path
  services.ssh-agent.enable = true;

{{- if or (glob "/usr/share/wayland-sessions/*") (glob "/usr/share/xsessions/*") (stat "/mnt/wslg") }}

  # GPU libraries for nix graphical applications on a non-NixOS host
  targets.genericLinux.enable = true;

  # linked before checkExistingGpuDrivers, which prints the root command when the link fails
  home.activation.linkGpuDrivers = lib.hm.dag.entryBefore [ "checkExistingGpuDrivers" ] ''
    if [[ "$(readlink /run/opengl-driver || true)" != "${config.targets.genericLinux.gpu.drivers}" ]]; then
      # no -n since empty passwords would be refused
      run /usr/bin/sudo ${lib.getExe config.targets.genericLinux.gpu.setupPackage} || true
    fi
  '';
{{- end }}

{{- if or (gt (len .ai.runtimes) 0) (has "podman" .container.runtimes) }}

  nixpkgs.overlays = [
{{- if gt (len .ai.runtimes) 0 }}
    # apm-cli pins websockets<17 while nixpkgs ships 17, drop once nixpkgs relaxes it.
    (final: prev: {
      apm-cli = prev.apm-cli.overridePythonAttrs (old: {
        pythonRelaxDeps = (old.pythonRelaxDeps or [ ]) ++ [ "websockets" ];
      });
    })
{{- end }}
{{- if has "podman" .container.runtimes }}
    # podman-compose 1.6.0 loops on depends_on service_healthy (#1422, #1541), drop once a release has #1608.
    (final: prev: {
      podman-compose = prev.podman-compose.overridePythonAttrs (old: {
        version = "1.6.0-unstable-2026-11-13";
        # the commit id is the integrity check, so no hash to compute
        src = builtins.fetchGit {
          url = "https://github.com/containers/podman-compose";
          rev = "9063c48c0efca6cdcdf93c5fe142921fe4d100f1";
        };
      });
    })
{{- end }}
  ];
{{- end }}

{{- if has "docker" .container.runtimes }}

  systemd.user.services.docker = {
    Install.WantedBy = [ "default.target" ];
    Service = {
      # the user manager PATH has newuidmap but not the nix profile, pasta lives there
      Environment = [
        "DOCKERD_ROOTLESS_ROOTLESSKIT_NET=pasta"
        "DOCKERD_ROOTLESS_ROOTLESSKIT_PORT_DRIVER=implicit"
        "PATH=${config.home.profileDirectory}/bin:/usr/bin:/bin"
      ];
      ExecStart = "${pkgs.docker}/bin/dockerd-rootless";
    };
  };
{{- end }}

{{- if has "agentsview" .tools.mise }}

  systemd.user.services.agentsview = {
    Install.WantedBy = [ "default.target" ];
    Service = {
      ExecStart = "%h/.local/share/mise/shims/agentsview serve --no-browser";
      Restart = "on-failure";
      RestartSec = 30;
    };
  };
{{- end }}

{{- if ne .machine.kind "desktop" }}

  systemd.user.services.gopass-age-agent = {
    Install.WantedBy = [ "default.target" ];
    Service = {
      Environment = [
        "GOPASS_UMASK=077"
      ];
      ExecStart = "${pkgs.gopass}/bin/gopass age agent start";
      Restart = "on-failure";
      RestartSec = 30;
    };
  };

  systemd.user.services.gopass-secret-service = {
    Install.WantedBy = [ "default.target" ];
    Unit = {
      After = [ "gopass-age-agent.service" ];
      Requires = [ "gopass-age-agent.service" ];
    };
    Service = {
      # no TTY here, a locked agent must fail on empty stdin instead of spawning the gpg-agent.conf pinentry
      Environment = [
        "GIT_CONFIG_COUNT=1"
        "GIT_CONFIG_KEY_0=commit.gpgsign"
        "GIT_CONFIG_VALUE_0=false"
        "GOPASS_AGE_STDIN_PASSPHRASE=true"
        "GOPASS_UMASK=077"
      ];
      ExecStart = "${pkgs.gopass}/bin/gopass secret-service serve";
      Restart = "on-failure";
      RestartSec = 30;
    };
  };
{{- end }}

  # dotfiles management
  home.file = {
    # all dotfiles are managed by chezmoi for easier combination and drift review
  };

  # disable news on switch (spams logs for nothing)
  news.display = "silent";

  # home-manager auto install and self management
  programs.home-manager.enable = true;
}
