{{- $bundles := mergeOverwrite (dict "false" (dict) "true" (dict))
    (dict true (dict "age" "latest" "cosign" "latest" "node" "24" "sops" "latest" "usage" "latest"))
    (dict (has "agentsview" .tools.mise) (dict "agentsview" "latest"))
    (dict (has "bun" .tools.mise) (dict "bun" "latest"))
    (dict (has "codegraph" .tools.mise) (dict "codegraph" "latest"))
    (dict (has "context7" .tools.mise) (dict "context7" "latest" "context7-mcp" "latest"))
    (dict (has "destructive-command-guard" .tools.mise) (dict "destructive-command-guard" "latest"))
    (dict (has "gh" .tools.mise) (dict "gh" "latest"))
    (dict (has "gitlab-ci-local" .tools.mise) (dict "gitlab-ci-local" "latest"))
    (dict (has "glab" .tools.mise) (dict "glab" "latest"))
    (dict (has "go" .tools.mise) (dict "go" "latest" "golangci-lint" "latest"))
    (dict (has "hugo" .tools.mise) (dict "dart-sass" "latest" "hugo-extended" "latest"))
    (dict (has "incus" .tools.mise) (dict "incus" "latest"))
    (dict (has "java" .tools.mise) (dict "java" "lts" "maven" "latest"))
    (dict (has "just" .tools.mise) (dict "just" "latest"))
    (dict (has "k8s" .tools.mise) (dict "helm" "latest" "helm-ct" "latest" "helmfile" "latest" "krew" "latest" "kubectl" "latest" "kustomize" "latest"))
    (dict (has "kotlin" .tools.mise) (dict "kotlin" "latest"))
    (dict (has "mempalace" .tools.mise) (dict "mempalace" "latest"))
    (dict (has "opentofu" .tools.mise) (dict "opentofu" "latest" "tofu-ls" "latest" "tflint" "latest"))
    (dict (has "pre-commit" .tools.mise) (dict "pre-commit" "latest"))
    (dict (has "pulumi" .tools.mise) (dict "pulumi" "latest"))
    (dict (has "rtk" .tools.mise) (dict "rtk" "latest"))
    (dict (has "shell" .tools.mise) (dict "bash-language-server" "latest" "shellcheck" "latest"))
    (dict (has "terraform" .tools.mise) (dict "terraform" "latest" "terraform-ls" "latest" "tflint" "latest"))
