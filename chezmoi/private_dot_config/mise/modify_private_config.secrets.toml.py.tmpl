{{- /* agents run in their own systemd scope, so a fork bomb stays inside app.slice */ -}}
{{- $scope := list }}
{{- if stat "/run/systemd/system" }}{{ $scope = list "systemd-run" "--user" "--scope" "--quiet" "--slice=app.slice" "--" }}{{- end }}

{{- /* the VS Code extension calls the claude wrapper with its own binary as argv[0], run it then, else the nix claude */ -}}
{{- $claude := `{{ '--' if argv and '/extensions/anthropic.claude-code-' in argv[0] else env.HOME ~ '/.local/share/mise/shims/claude' }}` }}

{{- $wrappers := mergeOverwrite (dict "false" (dict) "true" (dict))
    (dict true (dict
        "chezmoi" (dict "run" (list "{{ env.HOME }}/.local/bin/chezmoi") "env" (dict "GH_TOKEN" "" "GITHUB_TOKEN" "" "GITLAB_TOKEN" ""))
        "mise" (dict "run" (list "{{ env.HOME }}/.local/bin/mise") "env" (dict "GH_TOKEN" "" "GITHUB_TOKEN" ""))))
    (dict (has "claude" .ai.runtimes)
      (dict "claude" (dict "run" (concat $scope (list "/usr/bin/env" $claude)) "env" (dict "ANTHROPIC_API_KEY" "" "ANTHROPIC_AUTH_TOKEN" "" "CLAUDE_CODE_OAUTH_TOKEN" ""))))
    (dict (has "copilot" .ai.runtimes)
      (dict "copilot" (dict "run" (concat $scope (list "{{ env.HOME }}/.local/share/mise/shims/copilot")) "env" (dict "COPILOT_GITHUB_TOKEN" ""))))
    (dict (has "opencode" .ai.runtimes)
      (dict "opencode" (dict "run" (concat $scope (list "{{ env.HOME }}/.local/share/mise/shims/opencode")) "env" (dict "ANTHROPIC_API_KEY" "" "ANTHROPIC_AUTH_TOKEN" "" "CLAUDE_CODE_OAUTH_TOKEN" "" "COPILOT_GITHUB_TOKEN" ""))))
    (dict (has "pi" .ai.runtimes)
      (dict "pi" (dict "run" (concat $scope (list "{{ env.HOME }}/.local/share/mise/shims/pi")) "env" (dict "ANTHROPIC_API_KEY" "" "ANTHROPIC_AUTH_TOKEN" "" "CLAUDE_CODE_OAUTH_TOKEN" "" "COPILOT_GITHUB_TOKEN" ""))))
    (dict (has "srt" .ai.sandboxes)
      (dict "srt" (dict "run" (list "{{ env.HOME }}/.local/share/mise/shims/srt") "env" (dict "ANTHROPIC_API_KEY" "" "ANTHROPIC_AUTH_TOKEN" "" "CLAUDE_CODE_OAUTH_TOKEN" "" "COPILOT_GITHUB_TOKEN" "")))) }}

{{- $set := dict }}
{{- $sort := list (list "wrappers") }}
{{- range $id, $wrapper := get $wrappers "true" }}
{{- $_ := set $set $id (dict "command" (first $wrapper.run) "args" (rest $wrapper.run) "env" $wrapper.env) }}
{{- $sort = append $sort (list "wrappers" $id "env") }}
{{- end }}

{{- $unset := list }}
{{- range $id, $_ := get $wrappers "false" }}{{ $unset = append $unset (list "wrappers" $id) }}{{- end }}

{{- includeTemplate "scripts/toml-merge.py" (dict "set" (dict "wrappers" $set) "sort" $sort "unset" $unset) }}
