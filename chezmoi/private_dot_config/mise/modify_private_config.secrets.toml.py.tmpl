{{- $claude := dict "command" "{{ env.HOME }}/.local/state/nix/profile/bin/claude" "args" (list) "env" (list "ANTHROPIC_API_KEY" "ANTHROPIC_AUTH_TOKEN" "CLAUDE_CODE_OAUTH_TOKEN") }}
{{- $copilot := dict "command" "{{ env.HOME }}/.local/state/nix/profile/bin/copilot" "args" (list) "env" (list "COPILOT_GITHUB_TOKEN") }}

{{- if stat "/run/systemd/system" }}
{{- $_ := set $claude "command" "systemd-run" }}
{{- $_ := set $claude "args" (list "--user" "--scope" "--quiet" "--slice=app.slice" "--" `{{ '/usr/bin/env' if argv and '/extensions/anthropic.claude-code-' in argv[0] else env.HOME ~ '/.local/state/nix/profile/bin/claude' }}`) }}
{{- $_ := set $copilot "command" "systemd-run" }}
{{- $_ := set $copilot "args" (list "--user" "--scope" "--quiet" "--slice=app.slice" "--" "{{ env.HOME }}/.local/state/nix/profile/bin/copilot") }}
{{- end }}

{{- $wrappers := dict
    "chezmoi" (dict "command" "{{ env.HOME }}/.local/bin/chezmoi" "args" (list) "env" (list "GH_TOKEN" "GITHUB_TOKEN" "GITLAB_TOKEN"))
    "claude" $claude
    "copilot" $copilot
    "mise" (dict "command" "{{ env.HOME }}/.local/bin/mise" "args" (list) "env" (list "GH_TOKEN" "GITHUB_TOKEN"))
    "srt" (dict "command" "{{ env.HOME }}/.local/share/mise/shims/srt" "args" (list) "env" (list "ANTHROPIC_API_KEY" "ANTHROPIC_AUTH_TOKEN" "CLAUDE_CODE_OAUTH_TOKEN" "COPILOT_GITHUB_TOKEN")) }}

{{- $config := dict }}
{{- $sort := list (list "wrappers") }}
{{- range $wrapper, $settings := $wrappers }}
{{- $env := dict }}{{- range $settings.env }}{{- $_ := set $env . "" }}{{- end }}
{{- $_ := set $config $wrapper (dict "command" $settings.command "args" $settings.args "env" $env) }}
{{- $sort = append $sort (list "wrappers" $wrapper "env") }}
{{- end }}

{{- includeTemplate "scripts/toml-merge.py" (dict "set" (dict "wrappers" $config) "sort" $sort "unset" list) }}
