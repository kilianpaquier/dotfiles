{{- /* agents run in their own systemd scope, so a fork bomb stays inside app.slice */ -}}
{{- $scope := list }}
{{- if stat "/run/systemd/system" }}{{ $scope = list "systemd-run" "--user" "--scope" "--quiet" "--slice=app.slice" "--" }}{{- end }}

{{- /* the VS Code extension calls the claude wrapper with its own binary as argv[0], run it then, else the nix claude */ -}}
{{- $claude := `{{ '--' if argv and '/extensions/anthropic.claude-code-' in argv[0] else env.HOME ~ '/.local/share/mise/shims/claude' }}` }}

{{- $managed := list "chezmoi" "claude" "copilot" "mise" "opencode" "pi" "srt" }}
{{- $wanted := dict
      "chezmoi" (dict
        "run" (list "{{ env.HOME }}/.local/bin/chezmoi")
        "env" (dict "GITHUB_TOKEN" "" "GITLAB_TOKEN" ""))
      "mise" (dict
        "run" (list "{{ env.HOME }}/.local/bin/mise")
        "env" (dict "GITHUB_TOKEN" "")) }}

{{- if has "claude" .ai.runtimes }}
  {{- $_ := set $wanted "claude" (dict "run" (concat $scope (list "/usr/bin/env" $claude)) "env" (dict "ANTHROPIC_API_KEY" "" "ANTHROPIC_AUTH_TOKEN" "" "CLAUDE_CODE_OAUTH_TOKEN" "")) }}
{{- end }}
{{- if has "copilot" .ai.runtimes }}
  {{- $_ := set $wanted "copilot" (dict "run" (concat $scope (list "{{ env.HOME }}/.local/share/mise/shims/copilot")) "env" (dict "COPILOT_GH_HOST" "" "COPILOT_GITHUB_TOKEN" "")) }}
{{- end }}
{{- if has "opencode" .ai.runtimes }}
  {{- $_ := set $wanted "opencode" (dict
    "run" (concat $scope (list "{{ env.HOME }}/.local/share/mise/shims/opencode"))
    "env" (dict "ANTHROPIC_API_KEY" "" "ANTHROPIC_AUTH_TOKEN" "" "CLAUDE_CODE_OAUTH_TOKEN" "" "COPILOT_GH_HOST" "" "COPILOT_GITHUB_TOKEN" "")) }}
{{- end }}
{{- if has "pi" .ai.runtimes }}
  {{- $_ := set $wanted "pi" (dict
    "run" (concat $scope (list "{{ env.HOME }}/.local/share/mise/shims/pi"))
    "env" (dict "ANTHROPIC_API_KEY" "" "ANTHROPIC_AUTH_TOKEN" "" "CLAUDE_CODE_OAUTH_TOKEN" "" "COPILOT_GH_HOST" "" "COPILOT_GITHUB_TOKEN" "")) }}
{{- end }}
{{- if has "srt" .ai.sandboxes }}
  {{- $_ := set $wanted "srt" (dict
    "run" (concat $scope (list "{{ env.HOME }}/.local/share/mise/shims/srt"))
    "env" (dict "ANTHROPIC_API_KEY" "" "ANTHROPIC_AUTH_TOKEN" "" "CLAUDE_CODE_OAUTH_TOKEN" "" "COPILOT_GH_HOST" "" "COPILOT_GITHUB_TOKEN" "")) }}
{{- end }}

{{- $set := dict }}
{{- $sort := list (list "wrappers") }}
{{- range $id, $wrapper := $wanted }}
{{- $_ := set $set $id (dict "command" (first $wrapper.run) "args" (rest $wrapper.run) "env" $wrapper.env) }}
{{- $sort = append $sort (list "wrappers" $id "env") }}
{{- end }}

{{- $unset := list }}
{{- range $managed }}{{ if not (hasKey $wanted .) }}{{ $unset = append $unset (list "wrappers" .) }}{{- end }}{{- end }}

{{- includeTemplate "scripts/toml-merge.py" (dict "set" (dict "wrappers" $set) "sort" $sort "unset" $unset) }}
