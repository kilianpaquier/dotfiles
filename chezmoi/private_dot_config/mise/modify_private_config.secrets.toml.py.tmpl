{{- $wrappers := dict
    "chezmoi" (dict "command" "{{ env.HOME }}/.local/bin/chezmoi" "env" (list "GITHUB_TOKEN" "GITLAB_TOKEN"))
    "claude" (dict "command" "{{ env.HOME }}/.local/state/nix/profile/bin/claude" "env" (list "ANTHROPIC_API_KEY" "ANTHROPIC_AUTH_TOKEN" "CLAUDE_CODE_OAUTH_TOKEN"))
    "copilot" (dict "command" "{{ env.HOME }}/.local/state/nix/profile/bin/copilot" "env" (list "COPILOT_GITHUB_TOKEN"))
    "mise" (dict "command" "{{ env.HOME }}/.local/state/nix/profile/bin/mise" "env" (list "GITHUB_TOKEN"))
    "sbx" (dict "command" "{{ env.HOME }}/.local/state/nix/profile/bin/sbx" "env" (list "ANTHROPIC_API_KEY" "ANTHROPIC_AUTH_TOKEN" "CLAUDE_CODE_OAUTH_TOKEN" "COPILOT_GITHUB_TOKEN"))
    "srt" (dict "command" "{{ env.HOME }}/.local/state/nix/profile/bin/srt" "env" (list "ANTHROPIC_API_KEY" "ANTHROPIC_AUTH_TOKEN" "CLAUDE_CODE_OAUTH_TOKEN" "COPILOT_GITHUB_TOKEN")) }}

{{- $config := dict }}
{{- $sort := list (list "wrappers") }}
{{- range $wrapper, $settings := $wrappers }}
{{- $env := dict }}{{- range $settings.env }}{{- $_ := set $env . "" }}{{- end }}
{{- $_ := set $config $wrapper (dict "command" $settings.command "env" $env) }}
{{- $sort = append $sort (list "wrappers" $wrapper "env") }}
{{- end }}

{{- includeTemplate "scripts/toml-merge.py" (dict "set" (dict "wrappers" $config) "sort" $sort "unset" list) }}
