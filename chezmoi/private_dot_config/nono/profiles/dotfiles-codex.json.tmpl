{{- $agent := .sandbox.agents.codex -}}
{
    "extends": "dotfiles",
    "filesystem": {
        "allow": {{ $agent.write | sortAlpha | toPrettyJson "    " | indent 8 | trim }},
        "allow_file": {{ $agent.write_files | sortAlpha | toPrettyJson "    " | indent 8 | trim }},
        "read": {{ $agent.read | sortAlpha | toPrettyJson "    " | indent 8 | trim }},
        "read_file": {{ $agent.read_files | sortAlpha | toPrettyJson "    " | indent 8 | trim }}
    },
    "meta": {
        "name": "dotfiles-codex"
    }
}
