{
    "lspServers": {
{{- if has "go" .tools.mise }}
        "go": {
            "command": "gopls",
            "args": [],
            "fileExtensions": {
                ".go": "go"
            }
        },
{{- end }}
{{- if has "java" .tools.mise }}
        "java": {
            "command": "jdtls",
            "args": [],
            "fileExtensions": {
                ".java": "java"
            }
        },
{{- end }}
{{- if has "kotlin" .tools.mise }}
        "kotlin": {
            "command": "kotlin-lsp",
            "args": ["--stdio"],
            "fileExtensions": {
                ".kt": "kotlin",
                ".kts": "kotlin"
            }
        },
{{- end }}
{{- if has "opentofu" .tools.mise }}
        "opentofu": {
            "command": "tofu-ls",
            "args": ["serve"],
            "fileExtensions": {
                ".tf": "opentofu",
                ".tfvars": "opentofu-vars",
                ".tofu": "opentofu"
            }
        },
{{- end }}
{{- if has "shell" .tools.mise }}
        "shellscript": {
            "command": "bash-language-server",
            "args": ["start"],
            "fileExtensions": {
                ".bash": "shellscript",
                ".sh": "shellscript"
            }
        },
{{- end }}
{{- if has "terraform" .tools.mise }}
        "terraform": {
            "command": "terraform-ls",
            "args": ["serve"],
            "fileExtensions": {
                ".policy.hcl": "terraform-policy",
                ".policytest.hcl": "terraform-policytest",
                ".tf": "terraform",
                ".tfcomponent.hcl": "terraform-stack",
                ".tfdeploy.hcl": "terraform-deploy",
                ".tfquery.hcl": "terraform-search",
                ".tfvars": "terraform-vars"
            }
        },
{{- end }}
    }
}
