#!/bin/sh
# Code generated by AI (Claude Code)

set -e

# shellcheck disable=SC3040
(set -o pipefail >/dev/null 2>&1) && set -o pipefail

remote_cli=
for dir in "$HOME"/.vscode-server/bin/*/bin/remote-cli; do
  if [ -z "$remote_cli" ] || [ "$dir" -nt "$remote_cli" ]; then
    remote_cli="$dir"
  fi
done

if [ ! -d "$remote_cli" ]; then
  echo "No vscode-server installation found in '$HOME/.vscode-server/bin'" >&2
  exit 127
fi

# Outside a VS Code terminal, or with a socket inherited from a closed window (herdr server), "code" needs the IPC socket of a running window.
# Some listening sockets never answer, so take the highest inode, which belongs to the last opened window.
if [ -z "$VSCODE_IPC_HOOK_CLI" ] || [ -z "$(ss -Hxl src "$VSCODE_IPC_HOOK_CLI")" ]; then
  VSCODE_IPC_HOOK_CLI="$(ss -Hxl src "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/vscode-ipc-*" | awk '$6 > inode { inode = $6; sock = $5 } END { print sock }')"
  export VSCODE_IPC_HOOK_CLI
fi

exec "$remote_cli/code" "$@"
