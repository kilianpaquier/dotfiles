#!/bin/zsh
# shellcheck disable=SC1071

# Don't start tmux.
# zstyle ':z4h:' start-tmux 'no'
# Move prompt to the bottom when zsh starts and on Ctrl+L.
zstyle ':z4h:' prompt-at-bottom 'no'
# Recursively traverse directories when TAB-completing files.
zstyle ':z4h:fzf-complete' recurse-dirs 'no'

zstyle ':omz:plugins:ssh-agent' lazy yes
# zstyle ':omz:plugins:ssh-agent' lifetime 1h
zstyle ':omz:plugins:ssh-agent' quiet yes
zstyle ':omz:plugins:ssh-agent' honor-existing yes

# Download required plugins repositories before z4h initialization
repos=(
  kilianpaquier/zsh-plugins
  ohmyzsh/ohmyzsh
)
for repo in $repos; do z4h install "$repo"; done
unset repo repos

# Load required plugins synchronously before z4h initialization
plugins=(
  kilianpaquier/zsh-plugins/history
)
for plugin in $plugins; do z4h load "$plugin"; done
unset plugin plugins

# Install or update core components (fzf, zsh-autosuggestions, etc.) and
# initialize Zsh. After this point console I/O is unavailable until Zsh
# is fully initialized. Everything that requires user interaction or can
# perform network I/O must be done above. Everything else is best done below.
z4h init || return

# Completions shipped by nix packages
[ -d $HOME/.nix-profile/share/zsh/site-functions ] && fpath+=("$HOME/.nix-profile/share/zsh/site-functions")

# Completions generated by kilianpaquier/zsh-plugins/completions
ZSH_COMPLETIONS=(
  "chezmoi completion zsh"
  "cosign completion zsh"
  "ct completion zsh"
  "dcg completions zsh"
  "gh completion -s zsh"
  "gitlab-ci-local --completion"
  "glab completion -s zsh"
  "golangci-lint completion zsh"
  "helm completion zsh"
  "helmfile completion zsh"
  "hugo completion zsh"
  "incus completion zsh"
  "just --completions zsh"
  "kickr completion zsh"
  "kickr.dev completion zsh"
  "kubectl completion zsh"
  "kustomize completion zsh"
  "plumber completion zsh"
  "sops completion zsh"
  "task --completion zsh"
  "uv generate-shell-completion zsh"
  "uvx --generate-shell-completion zsh"
)
ZSH_COMPLETIONS_HELP=(
  age
  age-keygen
)

# Load plugins asynchronously after z4h initialization
plugins=(
  ohmyzsh/ohmyzsh/plugins/ssh-agent

  kilianpaquier/zsh-plugins/completions
  kilianpaquier/zsh-plugins/disk-cleanup
  kilianpaquier/zsh-plugins/gpg-edit
  kilianpaquier/zsh-plugins/highlight-styles
  kilianpaquier/zsh-plugins/release-sync
)
for plugin in $plugins; do z4h load "$plugin"; done
unset plugin plugins
unset ZSH_COMPLETIONS ZSH_COMPLETIONS_HELP
